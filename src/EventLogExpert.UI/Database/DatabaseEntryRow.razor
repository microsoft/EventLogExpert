<div class="db-entry-row"
    @oncontextmenu="HandleContextMenu"
    @oncontextmenu:preventDefault="true">
    <div @attributes="CheckboxHiddenAttributes"
        class="db-entry-checkbox @(IsSelectionModeActive ? "db-entry-checkbox--visible" : null)">
        <Checkbox AriaLabel="@Localizer["Db_Entry_Aria_Select", Entry.FileName]"
            Disabled="@(!IsSelectionModeActive)"
            Value="IsSelected"
            ValueChanged="@(_ => OnSelectionToggle.InvokeAsync())" />
    </div>

    <div class="db-entry-row-content">
        <div class="db-entry-info">
            <div class="db-entry-name-line">
                <ChromelessButton CssClass="db-entry-name" id="@_nameButtonId" @ref="_nameButton">@Entry.FileName</ChromelessButton>
                @if (ShouldShowBadge)
                {
                    <span class="db-entry-badge" data-badge="@BadgeKind">@BadgeLabel</span>
                }
            </div>
            @if (HasOsStamp)
            {
                <span aria-label="@OsStampAriaLabel" class="db-entry-osstamp" role="img" title="@OsStampDetail">@OsStampSummary</span>
            }
        </div>

        <div class="db-entry-actions @(ShowPendingIndicator ? "db-entry-actions--pending" : null)">
            @if (ShowPendingIndicator)
            {
                <span class="visually-hidden" id="@_pendingStatusId">@Localizer["Db_Entry_PendingToggle"]</span>
            }

            @switch (PrimaryAction)
            {
                case ActionKind.Toggle:
                case ActionKind.DisabledToggle:
                    <OptionSelect AriaDescribedBy="@(ShowPendingIndicator ? _pendingStatusId : null)"
                        AriaLabelledBy="@_nameButtonId"
                        Disabled="@(PrimaryAction == ActionKind.DisabledToggle)"
                        UseStatusColors="true"
                        Value="EffectiveEnabled"
                        ValueChanged="@(_ => OnToggle.InvokeAsync())" />

                    break;

                case ActionKind.Spinner:
                    @if (UpgradeProgress is { } progress)
                    {
                        var verb = UpgradePhaseLocalizer.Describe(Localizer, progress.CurrentPhase);
                        var hasFile = !string.IsNullOrEmpty(progress.CurrentEntryName);
                        var hasPosition = progress.CurrentBatchSize > 1;

                        var displayText = hasFile ?
                            (hasPosition ?
                                Localizer["Db_Entry_PhaseProgress", verb, progress.CurrentBatchPosition, progress.CurrentBatchSize] :
                                verb) :
                            Localizer[progress.CurrentBatchSize == 1 ?
                                "Banner_Upgrade_Preparing_One" :
                                "Banner_Upgrade_Preparing_Many", progress.CurrentBatchSize];
                        var statusAriaLabel = hasFile ? Localizer["Db_Entry_ProgressAria", displayText, Entry.FileName] : displayText;

                        <span class="db-entry-upgrading">
                            <span class="db-entry-upgrading-status" role="status">
                                <span class="visually-hidden">@statusAriaLabel</span>
                                <i aria-hidden="true" class="bi bi-arrow-repeat db-entry-spinner loader-spin"></i>
                                <span aria-hidden="true" class="db-entry-upgrading-text" @key="verb">@displayText</span>
                            </span>
                            <Button CssClass="db-entry-cancel-btn" OnClick="OnCancelClick">
                                @Localizer["Modal_Cancel"]
                            </Button>
                        </span>
                    }
                    else
                    {
                        <span class="db-entry-upgrading">
                            <span class="db-entry-upgrading-status" role="status">
                                <span class="visually-hidden">@Localizer["Db_Entry_Upgrading"]</span>
                                <i aria-hidden="true" class="bi bi-arrow-repeat db-entry-spinner loader-spin"></i>
                                <span aria-hidden="true">@Localizer["Db_Entry_Upgrading"]</span>
                            </span>
                        </span>
                    }

                    break;

                case ActionKind.Upgrade:
                    <Button CssClass="db-entry-upgrade-btn"
                        Disabled="@IsUpgradeBlocked"
                        IconClass="bi bi-arrow-up-circle"
                        OnClick="@(() => OnUpgrade.InvokeAsync())"
                        aria-label="@Localizer["Db_Entry_Aria_Upgrade", Entry.FileName]">
                        @Localizer["Db_Entry_Upgrade"]
                    </Button>

                    break;

                case ActionKind.Retry:
                    <DangerButton CssClass="db-entry-upgrade-btn"
                        Disabled="@IsUpgradeBlocked"
                        IconClass="bi bi-arrow-clockwise"
                        OnClick="@(() => OnUpgrade.InvokeAsync())"
                        aria-label="@Localizer["Db_Entry_Aria_RetryUpgrade", Entry.FileName]">
                        @Localizer["Db_Entry_RetryUpgrade"]
                    </DangerButton>

                    break;

                case ActionKind.RestoreFromBackup:
                    <Button CssClass="db-entry-restore-btn"
                        Disabled="@IsRestoreBlocked"
                        IconClass="bi bi-arrow-counterclockwise"
                        OnClick="@(async () =>
                                 {
                                     if (!IsRestoreBlocked) { await OnRestoreFromBackup.InvokeAsync(); }
                                 })"
                        aria-label="@Localizer["Db_Entry_Aria_Restore", Entry.FileName]">
                        @Localizer["Db_Entry_Restore"]
                    </Button>

                    break;

                case ActionKind.RetryClassification:
                    <Button CssClass="db-entry-retry-classification-btn"
                        IconClass="bi bi-arrow-repeat"
                        OnClick="@(async () => await OnRetryClassification.InvokeAsync())"
                        aria-label="@Localizer["Db_Entry_Aria_RetryClassification", Entry.FileName]">
                        @Localizer["Db_Entry_RetryClassification"]
                    </Button>

                    break;
            }
        </div>
    </div>
</div>
