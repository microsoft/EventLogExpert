@inherits ModalBase<bool>

@if (_entries.Count > 0)
{
    <ModalChrome AcceptLabel="@Localizer["Modal_Apply"]"
        CancelLabel="@Localizer["Modal_Cancel"]"
        Footer="FooterPreset.AcceptCancel"
        FooterDisabled="@_isApplying"
        InlineAlert="@CurrentInlineAlert"
        MaxWidth="40rem"
        MinWidth="28rem"
        OnAccept="ApplyAsync"
        OnCancel="HandleCancelButtonClickAsync"
        OnDialogClosedByUser="HandleDialogClosedByUserAsync"
        OnInlineAlertResolved="HandleInlineAlertResolvedAsync"
        Title="@Localizer["Banner_Recovery_Needed_Title"]"
        @ref="ChromeRef">
        <p class="recovery-description">
            @(_entries.Count == 1 ?
                Localizer["DatabaseRecoveryModal_Description_One"] :
                Localizer["DatabaseRecoveryModal_Description_Many"]) @Localizer["DatabaseRecoveryModal_Explanation"]
        </p>

        <div class="recovery-batch-actions">
            <Button Disabled="@_isApplying" OnClick="RestoreAll">
                @Localizer["DatabaseRecoveryModal_RestoreAll"]
            </Button>
            <Button Disabled="@_isApplying" OnClick="DeleteAll">
                @Localizer["DatabaseRecoveryModal_DeleteAll"]
            </Button>
        </div>

        <ul class="recovery-rows">
            @foreach (var entry in _entries)
            {
                var rowFailed = _failedFileNames.Contains(entry.FileName);
                var radioGroup = $"recovery-action-{entry.FileName}";

                <li class="recovery-row @(rowFailed ? "recovery-row-failed" : "")">
                    <span class="recovery-row-name">@entry.FileName</span>
                    <label class="recovery-row-option">
                        <input checked="@(_selectedActions.GetValueOrDefault(entry.FileName) == RecoveryAction.Restore)"
                            disabled="@_isApplying"
                            name="@radioGroup"
                            @onchange="@(() => SelectAction(entry.FileName, RecoveryAction.Restore))"
                            type="radio" />
                        @Localizer["DatabaseRecoveryModal_Restore"]
                    </label>
                    <label class="recovery-row-option">
                        <input checked="@(_selectedActions.GetValueOrDefault(entry.FileName) == RecoveryAction.Delete)"
                            disabled="@_isApplying"
                            name="@radioGroup"
                            @onchange="@(() => SelectAction(entry.FileName, RecoveryAction.Delete))"
                            type="radio" />
                        @Localizer["DatabaseRecoveryModal_Delete"]
                    </label>
                </li>
            }
        </ul>
    </ModalChrome>
}
