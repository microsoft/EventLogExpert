@using EventLogExpert.Runtime.DebugLog
@if (Draft is { } draft)
{
    <div class="debug-log-filter-editor">
        <Button CssClass="debug-log-filter-exclude-toggle"
            IconClass="@(draft.IsExcluded ? "bi bi-slash-circle-fill" : "bi bi-slash-circle")"
            IconOnly
            OnClick="OnEditorExcludeToggled"
            aria-label="@(draft.IsExcluded ? Localizer["DebugLog_Filter_ExcludeAria_Excluded"].Value : Localizer["DebugLog_Filter_ExcludeAria_Included"].Value)"
            aria-pressed="@(draft.IsExcluded ? "true" : "false")"
            data-excluded="@(draft.IsExcluded ? "true" : "false")"
            data-tooltip="@(draft.IsExcluded ? Localizer["DebugLog_Filter_ExcludeTip_Excluded"].Value : Localizer["DebugLog_Filter_ExcludeTip_Included"].Value)"
            @ref="_editorFirstControl" />

        <ValueSelect AriaLabel="@Localizer["DebugLog_Filter_FieldAria"]"
            CssClass="input filter-dropdown"
            T="DebugLogFilterField"
            ToStringFunc="@FieldLabel"
            Value="draft.Field"
            ValueChanged="OnFieldChanged">
            @foreach (var field in Enum.GetValues<DebugLogFilterField>())
            {
                <ValueSelectItem T="DebugLogFilterField" Value="field" />
            }
        </ValueSelect>

        <ComparisonOperatorSelect AriaLabel="@Localizer["DebugLog_Filter_OperatorAria"]"
            CssClass="input filter-dropdown"
            MatchMode="draft.MatchMode"
            OnChanged="OnOperatorChanged"
            Operator="draft.Operator"
            SupportsMany="FieldSupportsMany"
            SupportsText="FieldSupportsText" />

        @if (draft.Field == DebugLogFilterField.Message)
        {
            <TextInput AriaLabel="@Localizer["DebugLog_Filter_ValueAria"]"
                CssClass="input filter-description"
                Value="@SingleValue"
                ValueChanged="OnSingleValueChanged" />
        }
        else if (draft.MatchMode == MatchMode.Many)
        {
            <ValueSelect AriaLabel="@Localizer["DebugLog_Filter_ValueAria"]"
                CssClass="input filter-multiselect-dropdown"
                EmptyText="@Localizer["DebugLog_Filter_AnyValue"]"
                IsMultiSelect
                T="string"
                ToStringFunc="@ValueLabel"
                Values="draft.Values"
                ValuesChanged="OnValuesChanged">
                <ValueSelectItem ClearItem T="string">@Localizer["DebugLog_Filter_AnyValue"]</ValueSelectItem>
                @foreach (var option in ValueOptions())
                {
                    <ValueSelectItem T="string" Value="option" />
                }
            </ValueSelect>
        }
        else
        {
            <ValueSelect AriaLabel="@Localizer["DebugLog_Filter_ValueAria"]"
                CssClass="input filter-value-dropdown"
                T="string"
                ToStringFunc="@ValueLabel"
                Value="@SingleValue"
                ValueChanged="OnSingleValueChanged">
                <ValueSelectItem ClearItem T="string">@Localizer["DebugLog_Filter_AnyValue"]</ValueSelectItem>
                @foreach (var option in ValueOptions())
                {
                    <ValueSelectItem T="string" Value="option" />
                }
            </ValueSelect>
        }

        @if (!draft.IsComplete)
        {
            <span class="visually-hidden" id="@_saveHintId">@Localizer["DebugLog_Filter_SaveHint"]</span>
        }
        <Button Disabled="@(!draft.IsComplete)"
            IconClass="bi bi-check-circle"
            IconOnly
            OnClick="OnSave"
            aria-describedby="@(!draft.IsComplete ? _saveHintId : null)"
            aria-label="@Localizer["DebugLog_Filter_SaveAria"]"
            data-tooltip="@(draft.IsComplete ? Localizer["DebugLog_Filter_SaveAria"].Value : Localizer["DebugLog_Filter_SaveHint"].Value)" />

        <Button IconClass="bi bi-x-circle"
            IconOnly
            OnClick="OnCancel"
            aria-label="@Localizer["DebugLog_Filter_CancelAria"]"
            data-tooltip="@Localizer["DebugLog_Filter_CancelAria"]" />

        @if (Applied is not null)
        {
            <DangerButton IconClass="bi bi-dash-circle"
                IconOnly
                OnClick="OnRemove"
                aria-label="@Localizer["DebugLog_Filter_RemoveAria"]"
                data-tooltip="@Localizer["DebugLog_Filter_RemoveAria"]" />
        }
    </div>
}
else if (Applied is { } applied)
{
    var summary = FilterSummary(applied);

    <div class="debug-log-filter-chip" data-disabled="@(applied.IsEnabled ? "false" : "true")">
        <Button CssClass="debug-log-filter-exclude-toggle"
            IconClass="@(applied.IsExcluded ? "bi bi-slash-circle-fill" : "bi bi-slash-circle")"
            IconOnly
            OnClick="OnExcludeToggled"
            aria-label="@(applied.IsExcluded ? Localizer["DebugLog_Filter_ExcludeAria_Excluded"].Value : Localizer["DebugLog_Filter_ExcludeAria_Included"].Value)"
            aria-pressed="@(applied.IsExcluded ? "true" : "false")"
            data-excluded="@(applied.IsExcluded ? "true" : "false")"
            data-tooltip="@(applied.IsExcluded ? Localizer["DebugLog_Filter_ExcludeTip_Excluded"].Value : Localizer["DebugLog_Filter_ExcludeTip_Included"].Value)" />

        <Button CssClass="debug-log-filter-enable-toggle"
            IconClass="@(applied.IsEnabled ? "bi bi-toggle-on" : "bi bi-toggle-off")"
            IconOnly
            OnClick="OnEnableToggled"
            aria-label="@(applied.IsEnabled ? Localizer["DebugLog_Filter_EnableAria_Enabled"].Value : Localizer["DebugLog_Filter_EnableAria_Disabled"].Value)"
            aria-pressed="@(applied.IsEnabled ? "true" : "false")"
            data-enabled="@(applied.IsEnabled ? "true" : "false")"
            data-tooltip="@(applied.IsEnabled ? Localizer["DebugLog_Filter_EnableTip_Enabled"].Value : Localizer["DebugLog_Filter_EnableTip_Disabled"].Value)" />

        <ChromelessButton CssClass="debug-log-filter-chip-edit"
            OnClick="OnEdit"
            aria-label="@Localizer["DebugLog_Filter_EditAria", summary]"
            data-tooltip="@Localizer["DebugLog_Filter_EditTip"]"
            @ref="_chipEditButton">
            <span class="debug-log-filter-summary" data-tooltip="@summary" data-tooltip-overflow>@summary</span>
        </ChromelessButton>

        <ChromelessButton CssClass="debug-log-filter-chip-remove"
            IconClass="bi bi-x-circle"
            OnClick="OnRemove"
            aria-label="@Localizer["DebugLog_Filter_RemoveRowAria", summary]"
            data-tooltip="@Localizer["DebugLog_Filter_RemoveAria"]" />
    </div>
}
