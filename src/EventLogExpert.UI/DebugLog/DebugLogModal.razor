@inherits ModalBase<bool>

<ModalChrome AriaLabel="@Localizer["DebugLog_Aria_Title"]"
    BodyLayout="ModalBodyLayout.Flex"
    CloseLabel="@Localizer["DebugLog_Close"]"
    Footer="FooterPreset.CloseOnly"
    Height="60%"
    InlineAlert="@CurrentInlineAlert"
    MaxWidth="min(100rem, calc(100vw - 2rem))"
    MinWidth="min(100rem, calc(100vw - 2rem))"
    OnClose="OnCancelAsync"
    OnDialogClosedByUser="HandleDialogClosedByUserAsync"
    OnInlineAlertResolved="HandleInlineAlertResolvedAsync"
    @ref="ChromeRef">
    <ChildContent>
        <div aria-label="@Localizer["DebugLog_Aria_Filters"]" class="debug-log-filter-tray" role="group">
            @foreach (var row in _rows)
            {
                <DebugLogFilterRow Applied="row.Applied"
                    AvailableCategories="CategoryFilterOptions()"
                    Draft="row.Editing"
                    OnCancel="@(() => CancelEditing(row))"
                    OnChanged="OnEditorChanged"
                    OnEdit="@(() => StartEditing(row))"
                    OnEnableToggled="@(() => ToggleEnable(row))"
                    OnExcludeToggled="@(() => ToggleExclude(row))"
                    OnRemove="@(() => RemoveFilter(row))"
                    OnSave="@(() => SaveFilter(row))"
                    @key="row.Id"
                    @ref="_editorRefs[row.Id]" />
            }

            <Button CssClass="debug-log-add-filter"
                IconClass="bi bi-plus-circle"
                OnClick="AddFilter"
                aria-label="@Localizer["DebugLog_AddFilter_Aria"]"
                data-tooltip="@Localizer["DebugLog_AddFilter_Aria"]"
                @ref="_addButton">
                @Localizer["DebugLog_AddFilter"]
            </Button>

            @if (_rows.Count == 0)
            {
                <span class="visually-hidden" id="debug-clear-filters-hint">@Localizer["DebugLog_ClearFilters_Hint"]</span>
            }
            <Button CssClass="debug-log-clear-filters"
                Disabled="@(_rows.Count == 0)"
                IconClass="bi bi-x-circle"
                OnClick="ClearFilters"
                aria-describedby="@(_rows.Count == 0 ? "debug-clear-filters-hint" : null)"
                aria-label="@Localizer["DebugLog_ClearFilters_Aria"]"
                data-tooltip="@(_rows.Count == 0 ? Localizer["DebugLog_ClearFilters_Hint"].Value : Localizer["DebugLog_ClearFilters_Aria"].Value)">
                @Localizer["DebugLog_ClearFilters"]
            </Button>
        </div>
        <div aria-busy="@(_hasLoaded ? "false" : "true")" aria-label="@Localizer["DebugLog_Aria_Entries"]" class="debug-log-viewport" role="region" tabindex="0">
            <Virtualize Context="line" ItemSize="@RowHeightPx" Items="_displayed" OverscanCount="20">
                <ItemContent>
                    <div class="debug-log-row" data-tooltip="@line" data-tooltip-overflow>@line</div>
                </ItemContent>
                <EmptyContent>
                    @if (_hasLoaded)
                    {
                        <span>@(_entries.Count == 0 ? Localizer["DebugLog_Empty"].Value : Localizer["DebugLog_NoMatches"].Value)</span>
                    }
                </EmptyContent>
            </Virtualize>
        </div>
    </ChildContent>
    <ExtraFooterContent>
        <div class="debug-log-footer">
            <div class="debug-log-footer-actions debug-log-footer-left">
                @if (DebugExportDisabledReason is not null)
                {
                    <span class="visually-hidden" id="debug-export-hint">@DebugExportDisabledReason</span>
                }
                <Button Disabled="@(!_hasLoaded || _filteredEntryCount == 0)"
                    OnClick="HandleExportAsync"
                    aria-describedby="@(DebugExportDisabledReason is null ? null : "debug-export-hint")"
                    data-tooltip="@DebugExportDisabledReason">
                    @Localizer["DebugLog_Export"]
                </Button>
                @if (DebugCopyDisabledReason is not null)
                {
                    <span class="visually-hidden" id="debug-copy-hint">@DebugCopyDisabledReason</span>
                }
                <Button Disabled="@(!_hasLoaded || _filteredEntryCount == 0)"
                    OnClick="HandleCopyAsync"
                    aria-describedby="@(DebugCopyDisabledReason is null ? null : "debug-copy-hint")"
                    data-tooltip="@DebugCopyDisabledReason">
                    @Localizer["DebugLog_Copy"]
                </Button>
            </div>
            <span aria-atomic="true" aria-live="polite" class="debug-log-footer-counter vcenter-text" role="status">
                @FooterCounterText
            </span>
            <div class="debug-log-footer-actions debug-log-footer-right">
                <Button OnClick="Refresh">@Localizer["DebugLog_Refresh"]</Button>
                <Button OnClick="ClearDebugLogFileAsync">@Localizer["DebugLog_ClearLog"]</Button>
            </div>
        </div>
    </ExtraFooterContent>
</ModalChrome>
