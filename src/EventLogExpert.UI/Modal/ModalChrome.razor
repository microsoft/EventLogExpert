<dialog aria-label="@(string.IsNullOrEmpty(Title) ? (string.IsNullOrEmpty(AriaLabel) ? Localizer["Modal_DialogAriaFallback"] : AriaLabel) : null)"
    aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : _titleId)"
    aria-modal="true"
    class="@DialogClass"
    data-body-layout="@BodyLayout.ToString().ToLowerInvariant()"
    @oncancel="HandleCancelEventAsync"
    @oncancel:preventDefault="true"
    @onclose="HandleCloseEventAsync"
    @onkeydown:stopPropagation="true"
    @onkeyup:stopPropagation="true"
    @ref="_dialogRef"
    style="@DialogInlineStyle">
    <div class="dialog-group">
        <div class="banner-region" inert="@HasInlineAlert">
            <BannerHost CriticalOnly="true" Location="BannerHostLocation.InsideModal" />
        </div>

        <header class="@(HasHeaderChrome ? "dialog-header" : "dialog-header-collapsed")" inert="@HasInlineAlert">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h2 class="dialog-title" data-tooltip="@Title" data-tooltip-overflow id="@_titleId" tabindex="-1">@Title</h2>
            }

            <div class="dialog-header-actions">
                <NotificationCenter Disabled="HasInlineAlert"
                    Location="BannerHostLocation.InsideModal"
                    ShowNotifications="ShowNotifications"
                    TriggerVisibilityChanged="OnNotificationTriggerVisibilityChanged" />
                @if (ShowCloseButton)
                {
                    <Button CssClass="dialog-close"
                        Disabled="@HasInlineAlert"
                        IconClass="bi bi-x-circle"
                        OnClick="HandleCloseButtonAsync"
                        aria-label="@EffectiveCloseButtonAriaLabel" />
                }
            </div>
        </header>

        <div class="dialog-body" inert="@HasInlineAlert">
            @ChildContent
        </div>

        <div class="footer-group" inert="@HasInlineAlert">
            @if (ExtraFooterContent is not null)
            {
                <div class="footer-extra@(StackFooterExtra ? " footer-extra-stacked" : null)">
                    @ExtraFooterContent
                </div>
            }

            @switch (Footer)
            {
                case FooterPreset.CloseOnly:
                    <Button Disabled="@(HasInlineAlert || FooterDisabled)"
                        OnClick="HandleCloseButtonAsync">
                        @EffectiveCloseLabel
                    </Button>

                    break;

                case FooterPreset.SaveCancel:
                    <div class="button-group">
                        <PrimaryButton Disabled="@(HasInlineAlert || FooterDisabled)"
                            OnClick="HandleSaveAsync">
                            @EffectiveSaveLabel
                        </PrimaryButton>
                        <Button Disabled="@(HasInlineAlert || FooterDisabled)"
                            OnClick="HandleCancelButtonAsync"
                            autofocus="@DefaultToCancel">
                            @EffectiveCancelLabel
                        </Button>
                    </div>
                    break;

                case FooterPreset.ImportExportClose:
                    <div class="button-group">
                        <Button Disabled="@(HasInlineAlert || FooterDisabled)"
                            OnClick="HandleImportAsync">
                            @EffectiveImportLabel
                        </Button>
                        <Button Disabled="@(HasInlineAlert || FooterDisabled)"
                            OnClick="HandleExportAsync">
                            @EffectiveExportLabel
                        </Button>
                    </div>

                    <Button Disabled="@(HasInlineAlert || FooterDisabled)"
                        OnClick="HandleCloseButtonAsync">
                        @EffectiveCloseLabel
                    </Button>

                    break;

                case FooterPreset.Dismiss:
                    <Button Disabled="@(HasInlineAlert || FooterDisabled)"
                        OnClick="HandleAcceptAsync"
                        autofocus="true">
                        @EffectiveAcceptLabel
                    </Button>

                    break;

                case FooterPreset.AcceptCancel:
                    <PrimaryButton Disabled="@(HasInlineAlert || FooterDisabled || AcceptDisabled)"
                        OnClick="HandleAcceptAsync"
                        autofocus="@(!DefaultToCancel)">
                        @EffectiveAcceptLabel
                    </PrimaryButton>

                    @if (!string.IsNullOrEmpty(SecondaryActionLabel))
                    {
                        <Button Disabled="@(HasInlineAlert || FooterDisabled || SecondaryActionDisabled)"
                            OnClick="HandleSecondaryActionAsync">
                            @SecondaryActionLabel
                        </Button>
                    }

                    <Button Disabled="@(HasInlineAlert || FooterDisabled)"
                        OnClick="HandleCancelButtonAsync"
                        autofocus="@DefaultToCancel">
                        @EffectiveCancelLabel
                    </Button>

                    break;

                case FooterPreset.None:
                    break;
            }
        </div>
    </div>

    @if (HasInlineAlert)
    {
        <div aria-hidden="true" class="inline-alert-overlay"></div>

        <section aria-describedby="@_inlineAlertMessageId"
            aria-label="@(string.IsNullOrEmpty(InlineAlert!.Title) ? Localizer["Modal_AlertAriaFallback"].Value : null)"
            aria-labelledby="@(string.IsNullOrEmpty(InlineAlert!.Title) ? null : _inlineAlertTitleId)"
            aria-modal="true"
            class="inline-alert"
            role="alertdialog">
            @if (!string.IsNullOrEmpty(InlineAlert.Title))
            {
                <h3 class="inline-alert-title" data-tooltip="@InlineAlert.Title" data-tooltip-overflow id="@_inlineAlertTitleId">@InlineAlert.Title</h3>
            }

            <p class="inline-alert-message" id="@_inlineAlertMessageId">@InlineAlert.Message</p>

            @if (InlineAlert.IsPrompt)
            {
                <TextInput AriaDescribedBy="@(ValidationError is not null ? _inlineAlertValidationErrorId : null)"
                    AriaInvalid="@(ValidationError is not null)"
                    AriaLabelledBy="@_inlineAlertMessageId"
                    CssClass="input dialog-input"
                    OnEnter="HandleInlineAlertAcceptOnEnterAsync"
                    UpdateOnInput="true"
                    Value="@_inlineAlertPromptValue"
                    ValueChanged="HandleInlineAlertPromptValueChanged"
                    @ref="_inlineAlertInput" />

                @if (ValidationError is not null)
                {
                    <p aria-live="polite"
                        class="inline-alert-validation-error"
                        id="@_inlineAlertValidationErrorId">
                        @ValidationError
                    </p>
                }
            }

            <div class="inline-alert-buttons">
                @if (!string.IsNullOrEmpty(InlineAlert.AcceptLabel))
                {
                    <PrimaryButton Disabled="@(ValidationError is not null)"
                        OnClick="HandleInlineAlertAcceptAsync"
                        autofocus="@(!InlineAlert.IsPrompt && !InlineAlert.DefaultToCancel)"
                        @ref="_inlineAlertAcceptButton">
                        @InlineAlert.AcceptLabel
                    </PrimaryButton>
                }
                @if (!string.IsNullOrEmpty(InlineAlert.SecondaryActionLabel))
                {
                    <Button Disabled="@(ValidationError is not null)"
                        OnClick="HandleInlineAlertSecondaryAsync">
                        @InlineAlert.SecondaryActionLabel
                    </Button>
                }
                <Button OnClick="HandleInlineAlertCancelAsync"
                    autofocus="@(InlineAlert.DefaultToCancel || string.IsNullOrEmpty(InlineAlert.AcceptLabel))"
                    @ref="_inlineAlertCancelButton">
                    @InlineAlert.CancelLabel
                </Button>
            </div>
        </section>
    }

    @* In-dialog MenuHost so context menus and shortcut-triggered menus render
       in the top-layer stacking context of this <dialog>, not behind it. *@
    <MenuHost />
</dialog>
