<ValueSelect AriaLabel="@(PropertyAriaLabelledBy is null ? Localizer["FilterEditor_PropertyLabel"].Value : null)"
    AriaLabelledBy="@PropertyAriaLabelledBy"
    CssClass="input filter-property-select"
    T="EventProperty"
    ToStringFunc="@(x => FilterLensLabelFormatter.PropertyName(Localizer, x))"
    @bind-Value="PropertyBinding">
    @foreach (var item in Enum.GetValues<EventProperty>()
        .Where(p => p != EventProperty.UserId || Comparison.Property == EventProperty.UserId)
        .OrderBy(p => FilterLensLabelFormatter.PropertyName(Localizer, p), StringComparer.CurrentCulture))
    {
        <ValueSelectItem T="EventProperty" Value="item" />
    }
</ValueSelect>

@if (IsEventDataProperty)
{
    <label class="visually-hidden" id="@($"{Id}_FieldName")">@Localizer["FilterEditor_FieldNameLabel"]</label>

    <ValueSelect AriaLabelledBy="@($"{Id}_FieldName")"
        CssClass="input filter-value-dropdown"
        IsInput
        T="string"
        Value="Comparison.EventDataFieldName"
        ValueChanged="HandleEventDataFieldNameChanged">
        @foreach (var name in EventDataFieldNames)
        {
            <ValueSelectItem T="string" Value="name" />
        }
    </ValueSelect>
}

@if (IsUserDataProperty)
{
    <label class="visually-hidden" id="@($"{Id}_UserDataFieldName")">@Localizer["FilterEditor_FieldNameLabel"]</label>

    <ValueSelect AriaLabelledBy="@($"{Id}_UserDataFieldName")"
        CssClass="input filter-value-dropdown"
        IsInput
        T="string"
        Value="Comparison.UserDataFieldName"
        ValueChanged="HandleUserDataFieldNameChanged">
        @foreach (var name in UserDataFieldNames)
        {
            <ValueSelectItem T="string" Value="name" />
        }
    </ValueSelect>
}

<label class="visually-hidden" id="@($"{Id}_Comparison")">@Localizer["FilterEditor_ComparisonLabel"]</label>
<ComparisonOperatorSelect AriaLabelledBy="@($"{Id}_Comparison")"
    MatchMode="Comparison.MatchMode"
    OnChanged="HandleOperatorChanged"
    Operator="Comparison.Operator"
    SupportsContainsMany="FilterPropertyConstraints.SupportsContainsMany(Comparison.Property)"
    SupportsMany="!IsTextOnlyProperty(Comparison.Property)"
    SupportsNoneOfMany="FilterPropertyConstraints.SupportsNoneOfMany(Comparison.Property)" />

<label class="visually-hidden" id="@($"{Id}_Value")">@Localizer["FilterEditor_ValueLabel"]</label>
@if (IsTextOnlyProperty(Comparison.Property))
{
    <TextInput AriaLabelledBy="@($"{Id}_Value")"
        CssClass="input filter-description"
        Value="@Comparison.Value"
        ValueChanged="HandleValueChanged" />
}
else if (Comparison.MatchMode == MatchMode.Many)
{
    <ValueSelect AriaLabelledBy="@($"{Id}_Value")"
        CssClass="input filter-multiselect-dropdown"
        EmptyText="@Localizer["FilterEditor_AllValues"].Value"
        IsMultiSelect
        T="string"
        ToStringFunc="MultiSelectDisplay"
        Values="Comparison.Values"
        ValuesChanged="HandleValuesChanged">
        <ValueSelectItem ClearItem T="string">@Localizer["FilterEditor_AllValues"]</ValueSelectItem>
        @foreach (var item in MultiSelectCandidates)
        {
            <ValueSelectItem T="string" Value="item" />
        }
    </ValueSelect>
}
else if (IsResolutionStatusEquality)
{
    <ValueSelect AriaLabelledBy="@($"{Id}_Value")"
        CssClass="input filter-value-dropdown"
        T="string"
        ToStringFunc="ClosedSetDisplay"
        Value="Comparison.Value"
        ValueChanged="HandleValueChanged">
        <ValueSelectItem ClearItem T="string">@Localizer["FilterEditor_AllValues"]</ValueSelectItem>
        @foreach (var item in Items)
        {
            <ValueSelectItem T="string" Value="item" />
        }
    </ValueSelect>
}
else
{
    <ValueSelect AriaLabelledBy="@($"{Id}_Value")"
        CssClass="input filter-value-dropdown"
        IsInput
        T="string"
        Value="Comparison.Value"
        ValueChanged="HandleValueChanged">
        <ValueSelectItem ClearItem T="string">@Localizer["FilterEditor_AllValues"]</ValueSelectItem>
        @foreach (var item in FilteredItems)
        {
            <ValueSelectItem T="string" Value="item" />
        }
    </ValueSelect>
}
