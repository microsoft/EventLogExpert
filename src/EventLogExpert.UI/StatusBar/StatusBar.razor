@using EventLogExpert.Eventing.Common.Channels
@using EventLogExpert.Runtime.StatusBar
@inherits PresentationViewComponentBase

@{
    var status = StatusBarSource.Current;

    var activeTable = status.Tabs.FirstOrDefault(table => table.Id == status.ActiveTabId);
    var hasChannel = status.Tabs.Any(table => table.LogPathType == LogPathType.Channel);
    var isFiltered = FilterApplied.IsFilteringEnabled;
    var isLoading = !status.LoadingActivities.IsEmpty;

    var source = StatusBarFormatter.FormatSource(activeTable, status.Tabs, status.Groups);
    var filterTooltip = StatusBarFormatter.FilterIndicatorTooltip(status.IsPersistentFilterActive, LensSource.Lenses.Count);

    var announcement = StatusBarFormatter.FormatActivityAnnouncement(
        isLoading,
        hasChannel && status.NewEventBufferIsFull,
        hasChannel && status.ContinuouslyUpdate,
        status.ResolverStatus,
        ResolveIndicator());
}

<div class="status-bar">
    <div class="status-bar-left">
        <span class="status-bar-source" title="@(activeTable?.FileName ?? source)">@source</span>

        @if (activeTable is not null)
        {
            var total = TotalRawCount(activeTable, status.Groups, status);

            var describesActiveTab = Presentation.ActiveTabId == activeTable.Id &&
                Presentation.State == PresentationState.Current;

            var shown = Presentation.View.Count;

            <span aria-hidden="true" class="status-bar-sep">|</span>
            <button aria-controls="stats-drawer"
                aria-expanded="@(StatsVisibility.IsVisible ? "true" : "false")"
                class="status-bar-stats"
                @onclick="ToggleStats"
                title="@(StatsVisibility.IsVisible ? "Hide statistics for these events" : "Show statistics for these events")"
                type="button">
                <span class="status-bar-counts">@StatusBarFormatter.FormatCounts(total, shown, isFiltered && describesActiveTab, status.SelectionCount)</span>
                <i aria-hidden="true" class="bi bi-caret-@(StatsVisibility.IsVisible ? "down" : "up")"></i>
            </button>
        }

        @if (isFiltered)
        {
            <span aria-hidden="true" class="status-bar-sep">|</span>
            <span class="status-bar-filter" title="@filterTooltip">Filtered</span>
        }
    </div>

    <div class="status-bar-right">
        <span aria-atomic="true" aria-live="polite" class="status-bar-announce" role="status">@announcement</span>

        @foreach (var loadingProgress in status.LoadingActivities)
        {
            <span class="status-bar-activity">Loading: @loadingProgress.Value.Loaded</span>

            @if (loadingProgress.Value.Failed > 0)
            {
                <span class="status-bar-activity status-bar-warn">Failed: @loadingProgress.Value.Failed</span>
            }
        }

        @if (hasChannel)
        {
            @if (status.ContinuouslyUpdate)
            {
                <span class="status-bar-activity status-bar-live">Continuously updating</span>
            }
            else
            {
                <span aria-live="off" class="status-bar-activity">New Events: @status.NewEventBufferCount</span>

                @if (status.NewEventBufferIsFull)
                {
                    <span class="status-bar-activity status-bar-warn">Buffer full</span>
                }
            }
        }

        @if (!string.IsNullOrEmpty(status.ResolverStatus))
        {
            <span class="status-bar-activity">@status.ResolverStatus</span>
        }
    </div>
</div>
