@using EventLogExpert.Eventing.Common.Channels
@using EventLogExpert.UI.Common
@using EventLogExpert.Runtime.StatusBar
@inherits PresentationViewComponentBase

@{
    var status = StatusBarSource.Current;

    var activeTable = status.Tabs.FirstOrDefault(table => table.Id == status.ActiveTabId);
    var hasChannel = status.Tabs.Any(table => table.LogPathType == LogPathType.Channel);
    var isFiltered = FilterApplied.IsFilteringEnabled;
    var isLoading = !status.LoadingActivities.IsEmpty;

    var loadingSummary = StatusBarTextComposer.Loading(Localizer, status.LoadingActivities);

    var source = StatusBarTextComposer.Source(Localizer, activeTable, status.Tabs, status.Groups);
    var filterTooltip = StatusBarTextComposer.FilterIndicatorTooltip(Localizer, status.IsPersistentFilterActive, LensSource.Lenses.Count);

    var announcement = StatusBarTextComposer.ActivityAnnouncement(
        Localizer,
        isLoading,
        hasChannel && status.NewEventBufferIsFull,
        hasChannel && status.ContinuouslyUpdate,
        status.ResolverStatus,
        ResolveIndicator());
}

<div class="status-bar">
    <div class="status-bar-left">
        <span class="status-bar-source" title="@(activeTable?.FileName ?? source)">@source</span>

        @if (activeTable is not null)
        {
            var scoped = status.ScopedCounts(activeTable);

            var describesActiveTab = Presentation.ActiveTabId == activeTable.Id &&
                Presentation.State == PresentationState.Current;

            var shown = Presentation.View.Count;

            <span aria-hidden="true" class="status-bar-sep">|</span>
            <button aria-controls="stats-drawer"
                aria-expanded="@(StatsVisibility.IsVisible ? "true" : "false")"
                class="status-bar-stats"
                @onclick="ToggleStats"
                title="@(StatsVisibility.IsVisible ? Localizer["StatusBar_Stats_Hide"] : Localizer["StatusBar_Stats_Show"])"
                type="button">
                <span class="status-bar-counts">
                    @StatusBarTextComposer.Counts(Localizer, scoped.Total, shown, isFiltered && describesActiveTab, status.SelectionCount)
                </span>
                <i aria-hidden="true" class="bi bi-caret-@(StatsVisibility.IsVisible ? "down" : "up")"></i>
            </button>

            <span aria-hidden="true" class="status-bar-sep">|</span>
            <button aria-label="@StatusBarTextComposer.CoverageAriaLabel(Localizer, scoped.Unresolved)"
                class="status-bar-coverage status-bar-stats"
                @onclick="OpenCoverage"
                title="@StatusBarTextComposer.CoverageTooltip(Localizer, scoped.Unresolved, scoped.Total)"
                type="button">
                <i aria-hidden="true" class="bi bi-patch-question"></i>
                <span class="status-bar-counts">@StatusBarTextComposer.CoverageChip(Localizer, scoped.Unresolved)</span>
            </button>
        }

        @if (isFiltered)
        {
            <span aria-hidden="true" class="status-bar-sep">|</span>
            <span class="status-bar-filter" title="@filterTooltip">@Localizer["StatusBar_Filter_Chip"]</span>
        }
    </div>

    <div class="status-bar-right">
        <span aria-atomic="true" aria-live="polite" class="status-bar-announce" role="status">@announcement</span>

        <span class="status-bar-activity status-bar-memory @StatusBarTextComposer.MemoryLevelClass(status.MemoryLevel)"
            title="@StatusBarTextComposer.MemoryTooltip(Localizer, status.MemoryUsedMebibytes, status.MemoryWorkingSetBytes, status.MemoryLevel)">
            @StatusBarTextComposer.MemoryValue(Localizer, status.MemoryUsedMebibytes, status.MemoryLevel)
        </span>
        @* Always rendered so this live region is present from first paint - only its content changes, so a band
           transition is announced but the initial Normal content on mount is not. *@
        <span aria-live="polite" class="status-bar-announce status-bar-memory-announce" role="status">
            @MemoryUsageLevelLocalizer.Announcement(Localizer, status.MemoryLevel)
        </span>

        @if (loadingSummary is { } loading)
        {
            <span class="status-bar-activity">@loading.Text</span>

            @if (loading.FailedEvents > 0)
            {
                <span class="status-bar-activity status-bar-warn">@StatusBarTextComposer.LoadingFailedText(Localizer, loading.FailedEvents)</span>
            }
        }

        @if (!string.IsNullOrEmpty(status.ResolverStatus))
        {
            <span class="status-bar-activity status-bar-resolver" title="@status.ResolverStatus">@status.ResolverStatus</span>
        }

        @if (hasChannel)
        {
            @if (status.ContinuouslyUpdate)
            {
                <span class="status-bar-activity status-bar-live">@Localizer["StatusBar_Activity_ContinuouslyUpdating"]</span>
            }
            else
            {
                @if (status.NewEventBufferIsFull)
                {
                    <span class="status-bar-activity status-bar-warn">@Localizer["StatusBar_Activity_BufferFull"]</span>
                }

                <button aria-live="off"
                    class="status-bar-activity status-bar-newevents"
                    @onclick="LoadNewEvents"
                    title="@(status.NewEventBufferCount == 0 ? Localizer["StatusBar_NewEvents_None"] : Localizer["StatusBar_NewEvents_Load"])"
                    type="button">
                    @StatusBarTextComposer.NewEventsLabel(Localizer, status.NewEventBufferCount)
                </button>
            }
        }
    </div>
</div>
