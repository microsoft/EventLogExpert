@if (AllLibraryTags.Count == 0)
{
    return;
}

<div aria-label="@Localizer["FilterLibrary_Tags_RegionAria"]"
    class="library-tag-management-panel"
    id="@Id"
    role="region">
    @if (AllLibraryTags.Count >= SearchVisibleThreshold)
    {
        <div class="library-tag-management-search">
            <input aria-label="@Localizer["FilterLibrary_Tags_FilterAria"]"
                @bind="_searchText"
                @bind:event="oninput"
                placeholder="@Localizer["FilterLibrary_Tags_FilterPlaceholder"]"
                type="text" />
        </div>
    }

    <div class="library-tag-management-rows">
        @foreach (var (tag, count) in FilteredTags())
        {
            <div class="library-tag-management-row" @key="tag">
                @if (_editingTag == tag)
                {
                    <input aria-label="@Localizer["FilterLibrary_Tags_RenameInputAria", tag]"
                        @bind="_editingNewName"
                        @bind:after="OnEditNameChanged"
                        @bind:event="oninput"
                        class="library-tag-management-row-edit-input"
                        @ref="_editInputRef"
                        type="text" />
                    <span class="library-tag-management-row-count">(@count)</span>

                    @if (_mergeTargetTag is not null)
                    {
                        <WarningButton IconClass="bi bi-union"
                            OnClick="ConfirmMergeAsync"
                            aria-label="@MergeAriaLabel(tag, _mergeTargetTag, count)">
                            @Localizer["FilterLibrary_Tags_MergeAction", _mergeTargetTag]
                        </WarningButton>
                    }
                    else
                    {
                        <PrimaryButton IconClass="bi bi-check2"
                            IconOnly
                            OnClick="ConfirmRenameAsync"
                            aria-label="@Localizer["FilterLibrary_Tags_SaveRenameAria", tag]" />
                    }

                    <Button IconClass="bi bi-x-circle"
                        IconOnly
                        OnClick="CancelEdit"
                        aria-label="@Localizer["FilterLibrary_Tags_CancelRenameAria"]" />
                }
                else if (_deleteConfirmTag == tag)
                {
                    <span class="library-tag-management-row-name">@tag</span>
                    <span class="library-tag-management-row-count">(@count)</span>
                    <span class="library-tag-management-row-confirm">@RemoveConfirmLabel(count)</span>

                    <DangerButton IconClass="bi bi-check2"
                        IconOnly
                        OnClick="ConfirmDeleteAsync"
                        aria-label="@Localizer["FilterLibrary_Tags_ConfirmDeleteAria", tag]" />

                    <Button IconClass="bi bi-x-circle"
                        IconOnly
                        OnClick="CancelDelete"
                        aria-label="@Localizer["FilterLibrary_Tags_CancelDeleteAria"]" />
                }
                else
                {
                    <span class="library-tag-management-row-name">@tag</span>
                    <span class="library-tag-management-row-count">(@count)</span>

                    <Button IconClass="bi bi-pencil"
                        IconOnly
                        OnClick="@(() => BeginRename(tag))"
                        aria-label="@Localizer["FilterLibrary_Tags_RenameActionAria", tag]"
                        title="@Localizer["FilterLibrary_Tags_RenameTitle"]" />

                    <DangerButton IconClass="bi bi-trash"
                        IconOnly
                        OnClick="@(() => BeginDelete(tag))"
                        aria-label="@Localizer["FilterLibrary_Tags_DeleteActionAria", tag]"
                        title="@Localizer["FilterLibrary_Tags_DeleteTitle"]" />
                }
            </div>
        }
    </div>
</div>
