@if (!_isExpanded)
{
    <Button CssClass="library-saved-tab-new-button" IconClass="bi bi-plus-circle" OnClick="ExpandAsync">
        @Localizer["FilterLibrary_Entry_NewSavedFilterAction"]
    </Button>
}
else
{
    <div aria-label="@Localizer["FilterLibrary_Entry_NewSavedFilterDraftAria"]"
        class="library-saved-tab-new-draft"
        role="region">
        <div class="library-saved-tab-new-draft-name">
            <label for="@_nameInputId">@Localizer["FilterLibrary_Entry_NameLabel"]</label>
            <input @bind="_draftName"
                @bind:after="OnNameChanged"
                @bind:event="oninput"
                id="@_nameInputId"
                placeholder="@Localizer["FilterLibrary_Entry_NamePlaceholder"]"
                @ref="_nameInputRef"
                type="text" />
        </div>

        @if (_validationError is not null)
        {
            <span class="library-saved-tab-new-draft-error" role="alert">@_validationError</span>
        }

        <LibraryFilterRow Id="@_filterRowId"
            OnPendingDiscard="DiscardAsync"
            OnPendingSave="OnPendingSaveAsync"
            PendingDraft="_pendingDraft" />

        <div class="library-saved-tab-new-draft-tags">
            <TagPicker AriaLabel="@Localizer["FilterLibrary_Entry_NewSavedFilterTagsAria"]"
                Placeholder="@Localizer["FilterLibrary_Entry_TagInputPlaceholder"]"
                RemoveTagAriaLabelFormat="@Localizer["FilterLibrary_Entry_RemoveTagChipAria"]"
                SuggestionSource="@AllLibraryTags"
                Value="@_draftTags"
                ValueChanged="@OnDraftTagsChangedAsync" />
        </div>
    </div>
}
