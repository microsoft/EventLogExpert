@inherits ModalBase<bool>

<ModalChrome AriaLabel="@Localizer["FilterLibrary_ModalAria"]"
    BodyLayout="ModalBodyLayout.Flex"
    Footer="FooterPreset.ImportExportClose"
    Height="80%"
    InlineAlert="@CurrentInlineAlert"
    MaxWidth="min(80rem, calc(100vw - 2rem))"
    MinWidth="min(80rem, calc(100vw - 2rem))"
    OnClose="OnCancelAsync"
    OnDialogClosedByUser="HandleDialogClosedByUserAsync"
    OnExport="OnExportAsync"
    OnImport="OnImportAsync"
    OnInlineAlertResolved="HandleInlineAlertResolvedAsync"
    @ref="ChromeRef">
    <ChildContent>
        @if (LibraryLoadStatus.Current.LoadError)
        {
            <div class="filter-library-error" role="alert">
                <p>@Localizer["FilterLibrary_LoadError"]</p>
                <Button OnClick="RetryLoad">@Localizer["FilterLibrary_Retry"]</Button>
            </div>
        }
        else if (!LibraryLoadStatus.Current.IsLoaded)
        {
            <p aria-busy="true" class="filter-library-loading">@Localizer["FilterLibrary_Loading"]</p>
        }
        else
        {
            <CascadingValue IsFixed="true" Value="_authoringContext">
                <SidebarTabs IsTabpanelFocusable="@IsTabpanelEmpty"
                    TTab="LibraryTab"
                    TablistAriaLabel="@Localizer["FilterLibrary_ViewsAria"]"
                    Tabs="@CurrentTabLabels"
                    @bind-ActiveTab="_activeTab"
                    @ref="_sidebarTabsRef">
                    <TabContent Context="tab">
                        @{
                            var tagManagementPanelId = GetTagManagementPanelId(tab);
                            var tagOverflowRegionId = GetTagOverflowRegionId(tab);
                        }
                        @if (AllLibraryTags.Count > 0)
                        {
                            <div aria-label="@Localizer["FilterLibrary_TagFilterAria"]"
                                class="library-tag-filter-bar"
                                @onkeydown="HandleTagFilterBarKeyDown"
                                role="group">
                                <span class="library-tag-filter-bar-label">@Localizer["FilterLibrary_TagsLabel"]</span>
                                <Button CssClass="library-tag-management-trigger"
                                    IconClass="bi bi-gear"
                                    IconOnly
                                    OnClick="ToggleTagManagement"
                                    aria-controls="@(_isTagManagementExpanded ? tagManagementPanelId : null)"
                                    aria-expanded="@(_isTagManagementExpanded ? "true" : "false")"
                                    aria-label="@(_isTagManagementExpanded ? Localizer["FilterLibrary_HideTagManagementAria"] : Localizer["FilterLibrary_ManageTagsAria"])"
                                    title="@Localizer["FilterLibrary_ManageTagsTitle"]" />
                                @{
                                    var visibleTags = AllLibraryTags.Take(TagFilterBarMaxVisible).ToList();
                                    var hiddenTagsCount = AllLibraryTags.Count - visibleTags.Count;
                                }
                                @foreach (var tag in visibleTags)
                                {
                                    var isSelected = _selectedTagsByTab[tab].Contains(tag, StringComparer.OrdinalIgnoreCase);

                                    <ChromelessButton CssClass="library-tag-filter-chip"
                                        OnClick="@(() => ToggleTagFilter(tag))"
                                        aria-pressed="@(isSelected ? "true" : "false")">
                                        @tag
                                    </ChromelessButton>
                                }
                                @if (hiddenTagsCount > 0)
                                {
                                    <ChromelessButton CssClass="library-tag-filter-chip-overflow"
                                        OnClick="ToggleTagOverflowExpanded"
                                        aria-controls="@(_isTagOverflowExpanded ? tagOverflowRegionId : null)"
                                        aria-expanded="@(_isTagOverflowExpanded ? "true" : "false")"
                                        aria-label="@(_isTagOverflowExpanded ? Localizer["FilterLibrary_HideAdditionalTagsAria"] : ShowAdditionalTagsAria(hiddenTagsCount))">
                                        @(_isTagOverflowExpanded ? Localizer["FilterLibrary_ShowLess"] : Localizer["FilterLibrary_ShowMore", hiddenTagsCount])
                                    </ChromelessButton>
                                }
                                @if (_isTagOverflowExpanded && hiddenTagsCount > 0)
                                {
                                    <div class="library-tag-filter-bar-overflow" id="@tagOverflowRegionId">
                                        @foreach (var tag in AllLibraryTags.Skip(TagFilterBarMaxVisible))
                                        {
                                            var isOverflowSelected = _selectedTagsByTab[tab].Contains(tag, StringComparer.OrdinalIgnoreCase);

                                            <ChromelessButton CssClass="library-tag-filter-chip"
                                                OnClick="@(() => ToggleTagFilter(tag))"
                                                aria-pressed="@(isOverflowSelected ? "true" : "false")">
                                                @tag
                                            </ChromelessButton>
                                        }
                                    </div>
                                }
                            </div>

                            @if (_isTagManagementExpanded)
                            {
                                <TagManagementPanel AllEntries="@LibraryEntries.Current"
                                    AllLibraryTags="@AllLibraryTags"
                                    Id="@tagManagementPanelId"
                                    OnTagDeleted="HandleTagDeleted"
                                    OnTagRenamed="HandleTagRenamed" />
                            }
                        }
                        @switch (tab)
                        {
                            case LibraryTab.Saved:
                                <LibrarySavedTabHeader AllLibraryTags="@AllLibraryTags"
                                    ExistingSavedFilters="@SavedFilterEntries" />

                                @if (SavedEntries.Count == 0)
                                {
                                    <p class="library-empty-state">@GetEmptyStateMessage(tab)</p>
                                }
                                else
                                {
                                    @foreach (var entry in SavedEntries)
                                    {
                                        @RenderEntryRow(tab, entry)
                                    }
                                }

                                break;
                            case LibraryTab.Favorites:
                                @if (FavoriteEntries.Count == 0)
                                {
                                    <p class="library-empty-state">@GetEmptyStateMessage(tab)</p>
                                }
                                else
                                {
                                    @foreach (var entry in FavoriteEntries) { @RenderEntryRow(tab, entry) }
                                }

                                break;
                            case LibraryTab.PreviouslyUsed:
                                @if (PreviouslyUsedEntries.Count == 0)
                                {
                                    <p class="library-empty-state">@GetEmptyStateMessage(tab)</p>
                                }
                                else
                                {
                                    @foreach (var entry in PreviouslyUsedEntries) { @RenderEntryRow(tab, entry) }
                                }

                                break;
                        }
                    </TabContent>
                </SidebarTabs>
            </CascadingValue>
        }
    </ChildContent>
</ModalChrome>

@code {
    private RenderFragment RenderEntryRow(LibraryTab tab, LibraryEntry entry) =>
        __builder =>
        {
            <LibraryEntryRow ActiveTab="@tab"
                AllFilterSets="@AllFilterSets"
                AllLibraryTags="@AllLibraryTags"
                Entry="@entry"
                OnAddToFilterSet="@HandleAddToFilterSetAsync"
                OnApply="@HandleApplyAsync"
                OnCopyScenario="@OnCopyScenarioCallback"
                OnDelete="@HandleDelete"
                OnDisposed="@OnRowDisposed"
                OnExportEntry="@HandleExportEntryAsync"
                OnReplace="@HandleReplaceAsync"
                OnRequestPendingFocus="@(id => HandleRequestPendingFocusAsync(tab, id))"
                OnSaveScenario="@OnSaveScenarioCallback"
                OnSaveToLibrary="@HandleSaveToLibrary"
                OnToggleFavorite="@HandleToggleFavorite"
                @key="entry.Id"
                @ref="_rowRefs[(tab, entry.Id)]" />
        };
}
