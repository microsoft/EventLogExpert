<article class="library-entry" data-entry-id="@Entry.Id" @ref="_articleRef">
    <div class="library-entry-row-main">
        <i aria-label="@KindAriaLabel" class="@KindIconClass" role="img"></i>

        @if (Entry is LibraryEntryFilterSet)
        {
            <Button CssClass="library-entry-expand-toggle"
                IconClass="@(_isExpanded ? "bi bi-chevron-down" : "bi bi-chevron-right")"
                IconOnly
                OnClick="ToggleExpand"
                aria-controls="@_filterEditorRegionId"
                aria-expanded="@(_isExpanded ? "true" : "false")"
                aria-label="@Localizer["FilterLibrary_Entry_FiltersAria", Entry.Name]" />
        }

        <div class="library-entry-name">
            <span class="library-entry-name-text" data-tooltip="@Entry.Name" data-tooltip-overflow>@Entry.Name</span>
            @if (Entry is LibraryEntryFilterSet filterSet)
            {
                <span class="library-entry-detail">@LocalizedCount.OneOrManyRaw(Localizer, filterSet.Filters.Count, "FilterLibrary_Entry_FilterCount_One", "FilterLibrary_Entry_FilterCount_Many", filterSet.Filters.Count)</span>
            }
            @if (ActiveTab == LibraryTab.PreviouslyUsed)
            {
                <span aria-label="@Localizer["FilterLibrary_Entry_TrackedAria"]"
                    class="library-entry-tracked-badge"
                    data-tooltip="@Localizer["FilterLibrary_Entry_TrackedTitle"]">
                    @Localizer["FilterLibrary_Entry_TrackedLabel"]
                </span>

                @if (Entry.LastUsedUtc is { } lastUsed)
                {
                    <span class="library-entry-detail">@FormatRelativeTime(lastUsed)</span>
                }
            }
        </div>

        @if (!_isEditingTags)
        {
            <div class="library-entry-tag-chips-inline-wrapper">
                @if (Entry.Tags.Count > 0)
                {
                    <div class="library-entry-tag-chips-inline" role="list">
                        @{
                            var inlineVisible = Math.Min(Entry.Tags.Count, InlineTagChipCap);
                            var inlineHidden = Entry.Tags.Count - inlineVisible;
                        }
                        @for (int i = 0; i < inlineVisible; i++)
                        {
                            var tag = Entry.Tags[i];
                            <span class="library-entry-tag-chip" role="listitem">
                                <span class="library-entry-tag-chip-label">@tag</span>
                                <ChromelessButton CssClass="library-entry-tag-chip-remove"
                                    IconClass="bi bi-x-circle"
                                    OnClick="@(() => OnRemoveTagAsync(tag))"
                                    StopPropagation="true"
                                    aria-label="@Localizer["FilterLibrary_Entry_RemoveTagAria", tag]" />
                            </span>
                        }
                    </div>

                    @if (inlineHidden > 0)
                    {
                        <Button CssClass="library-entry-tag-chip-more"
                            OnClick="ToggleEditTagsMode"
                            aria-describedby="@($"library-more-tags-{ActiveTab}-{Entry.Id.Value:N}")"
                            aria-label="@Localizer["FilterLibrary_Entry_ShowAllTagsAria", Entry.Tags.Count]"
                            data-tooltip="@string.Join(", ", Entry.Tags.Skip(inlineVisible))">
                            @Localizer["FilterLibrary_Entry_MoreTags", inlineHidden]
                        </Button>

                        <span class="visually-hidden" id="@($"library-more-tags-{ActiveTab}-{Entry.Id.Value:N}")">@string.Join(", ", Entry.Tags.Skip(inlineVisible))</span>
                    }
                }
                <Button CssClass="library-entry-tag-add-inline"
                    IconClass="bi bi-plus-circle"
                    IconOnly
                    OnClick="ToggleEditTagsMode"
                    aria-label="@(Entry.Tags.Count == 0 ? Localizer["FilterLibrary_Entry_AddTagsAria", Entry.Name] : Localizer["FilterLibrary_Entry_EditTagsAria", Entry.Name])"
                    data-tooltip="@(Entry.Tags.Count == 0 ? Localizer["FilterLibrary_Entry_AddTagsTitle"] : Localizer["FilterLibrary_Entry_EditTagsTitle"])" />
            </div>
        }

        <PrimaryButton IconClass="bi bi-plus-circle"
            OnClick="OnApplyAsync"
            aria-label="@Localizer["FilterLibrary_Entry_ApplyAria", Entry.Name]">
            @Localizer["Modal_Apply"]
        </PrimaryButton>

        @if (IsFavoritable)
        {
            <WarningButton IconClass="@FavoriteIconClass"
                IconOnly
                OnClick="OnToggleFavoriteAsync"
                aria-label="@FavoriteAriaLabel"
                aria-pressed="@(Entry.IsFavorite ? "true" : "false")"
                data-tooltip="@FavoriteTitle" />
        }

        <Button IconClass="bi bi-three-dots-vertical"
            IconOnly
            OnClick="ToggleMoreMenuAsync"
            aria-expanded="@(IsMoreMenuOpen ? "true" : "false")"
            aria-haspopup="menu"
            aria-label="@Localizer["FilterLibrary_Entry_MoreActionsAria", Entry.Name]"
            data-tooltip="@Localizer["FilterLibrary_Entry_MoreActionsTitle"]"
            @ref="_moreMenuButton" />
    </div>

    @if (_isEditingTags)
    {
        <div class="library-entry-row-tags-edit">
            <TagPicker AriaLabel="@Localizer["FilterLibrary_Entry_TagsAria", Entry.Name]"
                Placeholder="@Localizer["FilterLibrary_Entry_TagInputPlaceholder"]"
                RemoveTagAriaLabelFormat="@Localizer["FilterLibrary_Entry_RemoveTagChipAria"]"
                SuggestionSource="@AllLibraryTags"
                Value="@Entry.Tags"
                ValueChanged="@OnTagsChangedAsync" />

            <Button CssClass="library-entry-tags-done"
                IconClass="bi bi-check2"
                IconOnly
                OnClick="ToggleEditTagsMode"
                aria-label="@Localizer["FilterLibrary_Entry_DoneEditingTagsAria"]"
                data-tooltip="@Localizer["FilterLibrary_Entry_DoneTitle"]" />
        </div>
    }

    @if (Entry is LibraryEntryFilterSet expandedSet)
    {
        <div class="library-entry-row-expanded" hidden="@(!_isExpanded)" id="@_filterEditorRegionId">
            @if (_isExpanded)
            {
                <LibraryEntryFilterEditor FilterSet="@expandedSet" IsExpanded="true" />
            }
        </div>
    }
</article>
