@inherits ModalBase<bool>

<ModalChrome AriaLabel="@Localizer["Stats_Detail_Title", StatsDimensionLocalizer.Label(Localizer, Dimension)]"
    CloseLabel="@Localizer["Stats_Detail_CloseLabel"]"
    Footer="FooterPreset.CloseOnly"
    Height="70%"
    InlineAlert="@CurrentInlineAlert"
    MaxWidth="40rem"
    MinWidth="26rem"
    OnClose="OnCancelAsync"
    OnDialogClosedByUser="HandleDialogClosedByUserAsync"
    OnInlineAlertResolved="HandleInlineAlertResolvedAsync"
    Title="@Localizer["Stats_Detail_Title", StatsDimensionLocalizer.Label(Localizer, Dimension)]"
    @ref="ChromeRef">
    <ChildContent>
        <div class="stats-detail">
            <input aria-label="@Localizer["Stats_Detail_FilterValuesAria"]"
                @bind="_search"
                @bind:event="oninput"
                class="input stats-detail-search"
                placeholder="@Localizer["Stats_Detail_FilterValuesPlaceholder"]"
                type="text" />

            @if (_loading)
            {
                <div class="stats-detail-status">@Localizer["Stats_Computing"]</div>
            }
            else if (_failed)
            {
                <div class="stats-detail-status">@Localizer["Stats_Detail_ComputeFailed"]</div>
            }
            else
            {
                @if (_distinct > _all.Count)
                {
                    <div class="stats-detail-truncated">@Localizer["Stats_Detail_Truncated", FormatCount(_all.Count), FormatCount(_distinct)]</div>
                }

                <div class="stats-detail-list">
                    @foreach (var row in VisibleRows)
                    {
                        <div class="stats-detail-row">
                            <span class="stats-detail-value" title="@row.Value">@row.Value</span>
                            <span class="stats-detail-count">@FormatCount(row.Count)</span>
                            <span class="stats-detail-percent">@FormatShare(row.Count)</span>
                            <span class="stats-detail-actions">
                                <button aria-label="@Localizer["Stats_Row_IncludeAria", StatsDimensionLocalizer.Label(Localizer, Dimension), row.Value]"
                                    class="stats-detail-include"
                                    @onclick="() => Include(row)"
                                    title="@Localizer["Stats_Row_IncludeTitle"]"
                                    type="button">
                                    <i aria-hidden="true" class="bi bi-plus-circle"></i>
                                </button>
                                <button aria-label="@Localizer["Stats_Row_ExcludeAria", StatsDimensionLocalizer.Label(Localizer, Dimension), row.Value]"
                                    class="stats-detail-exclude"
                                    @onclick="() => Exclude(row)"
                                    title="@Localizer["Stats_Row_ExcludeTitle"]"
                                    type="button">
                                    <i aria-hidden="true" class="bi bi-dash-circle"></i>
                                </button>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </ChildContent>
</ModalChrome>
