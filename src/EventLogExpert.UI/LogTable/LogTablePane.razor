@using EventLogExpert.UI.LogTable.Find
@using EventLogExpert.UI.LogTable.Grouping
@inherits PresentationViewComponentBase

<LogTabBar />

@{
    RenderFragment FindableCell((string? Text, bool Mark) context) =>
        @<text>
             @if (context.Mark)
             {
                 foreach (var segment in BuildFindSegments(context.Text))
                 {
                     if (segment.IsMark)
                     {
                         <mark class="find-mark">@segment.Text</mark>
                     }
                     else { @segment.Text }
                 }
             }
             else { @context.Text }
    </text>;

    RenderFragment RenderEventRow(DisplayRow row) =>
        @<tr aria-current="@(IsCurrentFindMatch(row) ? "true" : null)"
             aria-level="@(_rowView is null ? null : "2")"
             aria-rowindex="@GetRowIndex(row.Loc)"
             aria-selected="@_selectedSet.Contains(row.Loc).ToString().ToLower()"
             class="@GetCss(row.Loc)"
             data-find="@GetFindState(row)"
             data-highlight="@GetHighlight(row)"
             data-stripe="@GetRowStripe(row.Loc)"
             @key="row.Loc"
             @onmousedown="args => SelectEvent(args, row)"
             role="row"
             tabindex="0">
            @{
                bool isCurrentFindMatch = IsCurrentFindMatch(row);
            }
            @for (int i = 0; i < _enabledColumns.Length; i++)
            {
                var capturedColumn = _enabledColumns[i];

                <td aria-colindex="@(i + 1)"
                    @oncontextmenu="@(args => InvokeCellContextMenu(args, row, capturedColumn))"
                    @oncontextmenu:preventDefault="true"
                    @oncontextmenu:stopPropagation="true"
                    role="gridcell">

                    @if (capturedColumn == ColumnName.Level && GetLevelClass(row.Lean.Level) is { Length: > 0 } levelIcon)
                    {
                        <span aria-hidden="true" class="level-icon @levelIcon"></span>
                    }

                    @FindableCell((CellDisplayText(row.Lean, capturedColumn), isCurrentFindMatch))
                </td>
            }

            <td aria-colindex="@(_enabledColumns.Length + 1)"
                @oncontextmenu="@(args => InvokeCellContextMenu(args, row, null))"
                @oncontextmenu:preventDefault="true"
                @oncontextmenu:stopPropagation="true"
                role="gridcell">
                @FindableCell((row.Lean.Description, isCurrentFindMatch))
            </td>
        </tr>;
}

<div class="table-find-host" data-pane="table">
    @if (_findOpen)
    {
        <FindBar CaseSensitive="_findCaseSensitive"
            CaseSensitiveChanged="OnFindCaseChanged"
            CurrentOrdinal="FindCurrentOrdinal"
            FocusSignal="_findFocusSignal"
            IsScanning="_findScanning"
            MatchCount="FindMatchCount"
            OnClose="CloseFind"
            OnNext="FindNext"
            OnPrevious="FindPrevious"
            Query="@_findQuery"
            QueryChanged="OnFindQueryChanged"
            WholeWord="_findWholeWord"
            WholeWordChanged="OnFindWholeWordChanged"
            WrapAnnouncement="@_findWrapAnnouncement" />
    }
    <div aria-labelledby="eventTable" class="table-container" data-pane="table" data-pane-entry @onkeydown="HandleKeyDown" role="region" tabindex="0">
        @if (_indicator.Spinner)
        {
            <div aria-hidden="true" class="table-indicator">
                <span class="table-indicator-spinner"></span>
                @if (IndicatorSentence() is { } sentence)
                {
                    <span class="table-indicator-text">@sentence</span>
                }
            </div>
        }
        <table aria-busy="@(IsGridUpdating() ? "true" : null)"
            aria-label="@Localizer["Table_Aria"]"
            aria-multiselectable="true"
            aria-rowcount="@GetAriaRowCount()"
            id="eventTable"
            role="@(_rowView is null ? "grid" : "treegrid")">
            <thead @oncontextmenu="InvokeTableColumnMenu" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
            <tr role="row">
                @for (int columnIndex = 0; columnIndex < _enabledColumns.Length; columnIndex++)
                {
                    var columnHeader = _enabledColumns[columnIndex];
                    _headerName = ColumnNameLocalizer.Label(Localizer, columnHeader);
                    var width = GetColumnWidth(columnHeader);
                    var columnSorted = Presentation.Ordering.RequestedOrderBy == columnHeader;
                    var columnGrouped = Presentation.Ordering.RequestedGroupBy == columnHeader;

                    var indicatorClass = (columnSorted, columnGrouped) switch
                    {
                        (true, true) => " has-indicators-dual",
                        (true, false) or (false, true) => " has-indicator",
                        _ => string.Empty
                    };

                    var headerText = columnHeader == ColumnName.DateAndTime ? GetDateColumnHeader() : _headerName;

                    <th aria-colindex="@(columnIndex + 1)"
                        aria-description="@(columnGrouped ? TableOrderingTextComposer.GroupedColumnDescription(Localizer, Presentation.Ordering.RequestedIsGroupDescending) : null)"
                        aria-label="@headerText"
                        aria-sort="@(columnSorted ? Presentation.Ordering.RequestedIsDescending ? "descending" : "ascending" : "none")"
                        class="@(columnHeader.ToString().ToLowerInvariant() + indicatorClass)"
                        data-column="@columnHeader"
                        @key="columnHeader"
                        role="columnheader"
                        style="width: @(width)px">
                        @headerText
                        @if (columnSorted || columnGrouped)
                        {
                            <span class="th-indicators">
                                @if (columnSorted)
                                {
                                    <ChromelessButton CssClass="menu-toggle sort-toggle"
                                        IconClass="bi bi-caret-up"
                                        OnClick="ToggleSorting"
                                        StopKeyDownPropagation="true"
                                        aria-disabled="@(Presentation.State == PresentationState.Faulted ? "true" : null)"
                                        aria-label="@StatusBarTextComposer.SortDirectionAria(Localizer, columnHeader, Presentation.Ordering.RequestedIsDescending)"
                                        data-rotate="@Presentation.Ordering.RequestedIsDescending.ToString().ToLower()" />
                                }
                                @if (columnGrouped)
                                {
                                    <ChromelessButton CssClass="menu-toggle group-toggle"
                                        IconClass="bi bi-chevron-double-up"
                                        OnClick="ToggleGroupSorting"
                                        StopKeyDownPropagation="true"
                                        aria-disabled="@(Presentation.State == PresentationState.Faulted ? "true" : null)"
                                        aria-label="@StatusBarTextComposer.GroupDirectionAria(Localizer, columnHeader, Presentation.Ordering.RequestedIsGroupDescending)"
                                        data-rotate="@Presentation.Ordering.RequestedIsGroupDescending.ToString().ToLower()" />
                                }
                            </span>
                        }
                    </th>
                }

                <th aria-colindex="@(_enabledColumns.Length + 1)"
                    class="description"
                    role="columnheader">
                    @Localizer["Table_ColumnHeader_Description"]
                </th>
            </tr>
            </thead>
            <tbody @oncontextmenu="InvokeContextMenu" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
            @if (Presentation.ActiveTabId is not null)
            {
                @* SpacerElement="tr" keeps Blazor Virtualize's off-screen spacers as valid <tbody> children; the default <div> spacer is an invalid tbody child and corrupts the grouped grid's scroll geometry in WebView2. *@
                @if (_rowView is null)
                {
                    <Virtualize Context="row" ItemSize="@EventRowHeightPixels" ItemsProvider="LoadEventViewport" SpacerElement="tr" @ref="_eventVirtualize">
                        @RenderEventRow(row)
                    </Virtualize>
                }
                else
                {
                    var view = _rowView;

                    <Virtualize Context="row" ItemSize="@EventRowHeightPixels" Items="view" SpacerElement="tr">
                        @if (row.Kind == TableRowKind.Header)
                        {
                            var group = view.GroupAt(row);

                            <tr aria-expanded="@((!group.IsCollapsed).ToString().ToLower())"
                                aria-level="1"
                                aria-rowindex="@(group.VisibleStart + 2)"
                                class="group-header-row"
                                data-collapsed="@group.IsCollapsed.ToString().ToLower()"
                                @key="@($"hdr:{group.Key}")"
                                @onclick="() => ToggleGroupCollapsed(group.Key)"
                                @oncontextmenu="args => InvokeGroupContextMenu(args, group)"
                                @oncontextmenu:preventDefault="true"
                                @oncontextmenu:stopPropagation="true"
                                @onfocus="() => SetCursorHeader(group.Key)"
                                role="row"
                                tabindex="0">
                                <td colspan="@(_enabledColumns.Length + 1)" role="gridcell">
                                    <span class="group-chevron" data-collapsed="@group.IsCollapsed.ToString().ToLower()">
                                        <i aria-hidden="true" class="bi bi-caret-right"></i>
                                    </span>
                                    <span class="group-name">@GetGroupName():</span>
                                    <span class="group-value">@GetGroupValueText(group)</span>
                                    <span class="group-count">(@group.EventCount)</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @RenderEventRow(view.EventAt(row))
                        }
                    </Virtualize>
                }
            }
            </tbody>
        </table>
    </div>
</div>
