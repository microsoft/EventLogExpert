@using EventLogExpert.Eventing.Common.Events
@using EventLogExpert.Runtime.ResolutionCoverage
@inherits ModalBase<bool>

<ModalChrome AriaLabel="@Localizer["Coverage_AriaLabel"]"
    CloseLabel="@Localizer["Coverage_CloseLabel"]"
    Footer="FooterPreset.CloseOnly"
    Height="70%"
    InlineAlert="@CurrentInlineAlert"
    MaxWidth="min(72rem, calc(100vw - 2rem))"
    MinWidth="min(30rem, calc(100vw - 2rem))"
    OnClose="OnCancelAsync"
    OnDialogClosedByUser="HandleDialogClosedByUserAsync"
    OnInlineAlertResolved="HandleInlineAlertResolvedAsync"
    Title="@Localizer["Coverage_Title"]"
    @ref="ChromeRef">
<ChildContent>
    <div class="resolution-coverage">
        @if (_loading)
        {
            <div class="resolution-coverage-status">@Localizer["Coverage_Computing"]</div>
        }
        else if (_updating)
        {
            <div class="resolution-coverage-status">@Localizer["Coverage_ViewUpdating"]</div>
        }
        else if (_failed)
        {
            <div class="resolution-coverage-status">@(_faultCause is { Length: > 0 } cause ? Localizer["Coverage_UnavailableWithCause", cause] : Localizer["Coverage_ComputeFailed"])</div>
        }
        else if (_report is not null && _report.Summary.Total == 0)
        {
            <div class="resolution-coverage-status">@(_isFiltered ? Localizer["Coverage_NoEventsFiltered"] : Localizer["Coverage_NoEvents"])</div>
        }
        else if (_report is not null)
        {
            var matched = FilteredSortedRows();
            var shown = matched.Count > MaxProviders ? matched.Take(MaxProviders).ToList() : matched;

            <div class="resolution-coverage-summary">
                <div class="resolution-coverage-scope">
                    <span>@LocalizedCount.OneOrMany(Localizer, _report.Summary.Total, "Coverage_TotalEvents_One", "Coverage_TotalEvents_Many")</span>
                    @if (_isFiltered)
                    {
                        <span class="resolution-coverage-badge"
                            title="@Localizer["Coverage_FilteredViewTooltip"]">
                            @Localizer["Coverage_FilteredView"]
                        </span>
                    }
                </div>
                <div class="resolution-coverage-tallies">
                    <span class="resolution-tally">@Localizer["Coverage_ResolvedTallyLabel"] <strong>@FormatCount(_report.Summary.Resolved)</strong> (@FormatShare(_report.Summary.Resolved))</span>
                    <span class="resolution-tally">@Localizer["Coverage_UnresolvedTallyLabel"] <strong>@FormatCount(Unresolved)</strong> (@FormatShare(Unresolved))</span>
                </div>
                @{
                    var segments = ProportionSegments().ToList();
                }
                @if (segments.Count > 0)
                {
                    <div aria-label="@ProportionAriaLabel()" class="resolution-coverage-bar" role="img">
                        @foreach (var segment in segments)
                        {
                            <div class="resolution-coverage-seg @segment.CssClass" style="@SegmentWidth(segment.Percent)" title="@segment.Label"></div>
                        }
                    </div>
                }
                <div class="resolution-coverage-breakdown">
                    @foreach (var cause in CauseBreakdown())
                    {
                        var causeDisplay = ResolutionStatusLocalizer.Display(Localizer, cause.Status);

                        @if (cause.Count > 0)
                        {
                            <button class="resolution-cause-filter"
                                @onclick="() => FilterByCauseAsync(cause.Status)"
                                title="@Localizer["Coverage_FilterByCauseTooltip", causeDisplay]"
                                type="button">
                                @causeDisplay: @FormatCount(cause.Count)
                            </button>
                        }
                        else
                        {
                            <span class="resolution-cause-empty">@causeDisplay: @FormatCount(cause.Count)</span>
                        }
                    }
                </div>
            </div>

            <input aria-label="@Localizer["Coverage_FilterProvidersAria"]"
                @bind="_search"
                @bind:event="oninput"
                class="input resolution-coverage-search"
                placeholder="@Localizer["Coverage_FilterProvidersPlaceholder"]"
                type="text" />

            @if (matched.Count > shown.Count)
            {
                <div class="resolution-coverage-truncated">@Localizer["Coverage_ProvidersTruncated", FormatCount(shown.Count), FormatCount(matched.Count)]</div>
            }

            <div class="resolution-coverage-table" role="table">
                <div class="resolution-coverage-head" role="row">
                    <span aria-sort="@AriaSort(CoverageSortColumn.Provider)" role="columnheader">
                        <button class="resolution-sort"
                            @onclick="() => ToggleSort(CoverageSortColumn.Provider)"
                            type="button">
                            @Localizer["Coverage_Header_Provider"]
                        </button>
                    </span>
                    <span aria-sort="@AriaSort(CoverageSortColumn.Total)" role="columnheader">
                        <button class="resolution-num resolution-sort"
                            @onclick="() => ToggleSort(CoverageSortColumn.Total)"
                            type="button">
                            @Localizer["Coverage_Header_Events"]
                        </button>
                    </span>
                    <span aria-sort="@AriaSort(CoverageSortColumn.Resolved)" role="columnheader">
                        <button class="resolution-num resolution-sort"
                            @onclick="() => ToggleSort(CoverageSortColumn.Resolved)"
                            type="button">
                            @Localizer["Coverage_Header_Resolved"]
                        </button>
                    </span>
                    <span aria-sort="@AriaSort(CoverageSortColumn.NoProvider)"
                        role="columnheader"
                        title="@ResolutionStatusLocalizer.Display(Localizer, EventResolutionStatus.NoProvider)">
                        <button class="resolution-num resolution-sort"
                            @onclick="() => ToggleSort(CoverageSortColumn.NoProvider)"
                            type="button">
                            @Localizer["Coverage_Header_NoProvider"]
                        </button>
                    </span>
                    <span aria-sort="@AriaSort(CoverageSortColumn.NoMessage)"
                        role="columnheader"
                        title="@ResolutionStatusLocalizer.Display(Localizer, EventResolutionStatus.NoMessage)">
                        <button class="resolution-num resolution-sort"
                            @onclick="() => ToggleSort(CoverageSortColumn.NoMessage)"
                            type="button">
                            @Localizer["Coverage_Header_NoMessage"]
                        </button>
                    </span>
                    <span aria-sort="@AriaSort(CoverageSortColumn.Failed)"
                        role="columnheader"
                        title="@ResolutionStatusLocalizer.Display(Localizer, EventResolutionStatus.Failed)">
                        <button class="resolution-num resolution-sort"
                            @onclick="() => ToggleSort(CoverageSortColumn.Failed)"
                            type="button">
                            @Localizer["Coverage_Header_Error"]
                        </button>
                    </span>
                    <span aria-sort="@AriaSort(CoverageSortColumn.Coverage)" role="columnheader">
                        <button class="resolution-cov resolution-sort"
                            @onclick="() => ToggleSort(CoverageSortColumn.Coverage)"
                            type="button">
                            @Localizer["Coverage_Header_Coverage"]
                        </button>
                    </span>
                    <span role="columnheader"></span>
                </div>
                @for (int index = 0; index < shown.Count; index++)
                {
                    var row = shown[index];
                    <div class="resolution-coverage-row@(index % 2 == 1 ? " resolution-row-alt" : null)" role="row">
                        <span class="resolution-provider" role="cell" title="@row.Provider">
                            @if (row.Status != CoverageStatus.Full && !string.IsNullOrWhiteSpace(row.Provider))
                            {
                                <button aria-controls="@(IsExpanded(row) ? DetailId(index) : null)"
                                    aria-expanded="@(IsExpanded(row) ? "true" : "false")"
                                    class="resolution-provider-toggle"
                                    @onclick="() => ToggleExpandAsync(row)"
                                    type="button">
                                    <i aria-hidden="true" class="bi bi-caret-@(IsExpanded(row) ? "down" : "right")"></i>
                                    <span class="resolution-provider-name">@row.Provider</span>
                                </button>
                            }
                            else
                            {
                                <span class="resolution-provider-name">@row.Provider</span>
                            }
                        </span>
                        <span class="resolution-num" role="cell">@FormatCount(row.Counts.Total)</span>
                        <span class="resolution-num" role="cell">@FormatCount(row.Counts.Resolved)</span>
                        <span class="resolution-num" role="cell">@FormatCount(row.Counts.NoProvider)</span>
                        <span class="resolution-num" role="cell">@FormatCount(row.Counts.NoMessage)</span>
                        <span class="resolution-num" role="cell">@FormatCount(row.Counts.Failed)</span>
                        <span class="resolution-cov" role="cell"><span class="@CoverageCssClass(row.Status)" title="@CoverageTooltip(row)">@CoverageStatusLocalizer.Label(Localizer, row.Status)</span></span>
                        <span class="resolution-actions" role="cell">
                            <button aria-label="@Localizer["Coverage_FilterProviderAria", row.Provider]"
                                class="resolution-include"
                                @onclick="() => IncludeProviderAsync(row)"
                                title="@Localizer["Coverage_FilterProviderTooltip"]"
                                type="button">
                                <i aria-hidden="true" class="bi bi-plus-circle"></i>
                            </button>
                            <button aria-label="@Localizer["Coverage_ExcludeProviderAria", row.Provider]"
                                class="resolution-exclude"
                                @onclick="() => ExcludeProviderAsync(row)"
                                title="@Localizer["Coverage_ExcludeProviderTooltip"]"
                                type="button">
                                <i aria-hidden="true" class="bi bi-dash-circle"></i>
                            </button>
                            @if (row.Status != CoverageStatus.Full && !string.IsNullOrWhiteSpace(row.Provider))
                            {
                                <button aria-label="@Localizer["Coverage_FilterProviderUnresolvedAria", row.Provider]"
                                    class="resolution-lens"
                                    @onclick="() => FilterProviderUnresolvedAsync(row)"
                                    title="@Localizer["Coverage_FilterProviderUnresolvedTooltip"]"
                                    type="button">
                                    <i aria-hidden="true" class="bi bi-funnel"></i>
                                </button>
                            }
                            @if (ShowDatabaseAction(row))
                            {
                                <button aria-label="@Localizer["Coverage_OpenDatabaseToolsAria", row.Provider]"
                                    class="resolution-dbtools"
                                    @onclick="OpenDatabaseToolsAsync"
                                    title="@DatabaseActionTooltip(row)"
                                    type="button">
                                    <i aria-hidden="true" class="bi bi-database-add"></i>
                                </button>
                            }
                        </span>
                    </div>

                    @if (IsExpanded(row))
                    {
                        <div class="resolution-coverage-detail" role="row">
                            <div aria-colspan="8" class="resolution-detail-cell" role="cell">
                                <div aria-label="@Localizer["Coverage_DetailsForProviderAria", row.Provider]"
                                    class="resolution-detail-region"
                                    id="@DetailId(index)"
                                    role="region">
                                    @if (_detailLoading)
                                    {
                                        <div aria-busy="true" class="resolution-detail-status">@Localizer["Coverage_AnalyzingProvider", row.Provider]</div>
                                    }
                                    else if (_detailFailed)
                                    {
                                        <div class="resolution-detail-status">
                                            @Localizer["Coverage_ProviderAnalyzeFailed"]
                                            <button class="resolution-cause-filter"
                                                @onclick="() => RetryDetailAsync(row)"
                                                type="button">
                                                @Localizer["Coverage_Retry"]
                                            </button>
                                        </div>
                                    }
                                    else if (_detail is { } detail)
                                    {
                                        <div class="resolution-detail-hint">@RemediationHint(row)</div>

                                        @if (detail.Levels.Count > 0)
                                        {
                                            var sevSegments = SeveritySegments(detail).ToList();

                                            <div class="resolution-detail-section">
                                                <div class="resolution-detail-heading">@Localizer["Coverage_UnresolvedBySeverityHeading"]</div>
                                                @if (sevSegments.Count > 0)
                                                {
                                                    <div aria-label="@Localizer["Coverage_SeverityBarLabel"]" class="resolution-detail-sevbar" role="img">
                                                        @foreach (var seg in sevSegments)
                                                        {
                                                            <div class="resolution-detail-sevseg coverage-sev-@SeverityDisplay.Key(seg.Level)"
                                                                style="@SegmentWidth(seg.Percent)"
                                                                title="@Localizer["Coverage_SeveritySegmentTooltip", SeverityLevelLocalizer.Label(Localizer, seg.Level), FormatCount(seg.Unresolved)]">
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                <div class="resolution-detail-sevcounts">
                                                    @foreach (var level in detail.Levels)
                                                    {
                                                        <span class="resolution-detail-sevcount">
                                                            <span class="resolution-detail-sevdot coverage-sev-@SeverityDisplay.Key(level.Level)" />
                                                                @SeverityLevelLocalizer.Label(Localizer, level.Level): <strong>@FormatCount(level.Counts.Unresolved)</strong>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (detail.EventIds.Count > 0)
                                        {
                                            <div class="resolution-detail-section">
                                                <div class="resolution-detail-heading">
                                                    @Localizer["Coverage_UnresolvedEventIdsHeading"]
                                                    @if (detail.DistinctUnresolvedEventIdCount > detail.EventIds.Count)
                                                    {
                                                        <span class="resolution-detail-note">
                                                            @Localizer["Coverage_EventIdsTruncated", FormatCount(detail.EventIds.Count), FormatCount(detail.DistinctUnresolvedEventIdCount)]
                                                        </span>
                                                    }
                                                </div>
                                                <div class="resolution-detail-idtable" role="table">
                                                    <div class="resolution-detail-idhead resolution-detail-idrow" role="row">
                                                        <span role="columnheader">@Localizer["Coverage_Header_EventId"]</span>
                                                        <span class="resolution-num" role="columnheader">@Localizer["Coverage_Header_Total"]</span>
                                                        <span class="resolution-num" role="columnheader">@Localizer["Coverage_Header_Unresolved"]</span>
                                                        <span role="columnheader">@Localizer["Coverage_Header_Cause"]</span>
                                                        <span role="columnheader"></span>
                                                    </div>
                                                    @foreach (var idRow in detail.EventIds)
                                                    {
                                                        <div class="resolution-detail-idrow" role="row">
                                                            <span role="cell">@idRow.EventId</span>
                                                            <span class="resolution-num" role="cell">@FormatCount(idRow.Counts.Total)</span>
                                                            <span class="resolution-num" role="cell">@FormatCount(idRow.Counts.Unresolved)</span>
                                                            <span role="cell">@DominantCauseLabel(idRow.Counts)</span>
                                                            <span role="cell">
                                                                @if (!string.IsNullOrWhiteSpace(row.Provider))
                                                                {
                                                                    <button aria-label="@Localizer["Coverage_FilterEventIdUnresolvedAria", idRow.EventId, row.Provider]"
                                                                        class="resolution-lens"
                                                                        @onclick="() => FilterEventIdUnresolvedAsync(row.Provider, idRow.EventId)"
                                                                        title="@Localizer["Coverage_FilterEventIdUnresolvedTooltip"]"
                                                                        type="button">
                                                                        <i aria-hidden="true" class="bi bi-funnel"></i>
                                                                    </button>
                                                                }
                                                            </span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</ChildContent>
<ExtraFooterContent>
    @if (HasReport)
    {
        <div class="resolution-coverage-footer">
            @if (Unresolved > 0)
            {
                <Button CssClass="resolution-coverage-filter"
                    OnClick="ShowOnlyUnresolvedAsync"
                    title="@Localizer["Coverage_ShowOnlyUnresolvedTooltip"]">
                    @Localizer["Coverage_ShowOnlyUnresolved"]
                </Button>
            }
            <Button CssClass="resolution-coverage-copy"
                Disabled="@_copying"
                OnClick="CopyTableAsync"
                title="@Localizer["Coverage_CopyTableTooltip"]">
                @Localizer["Coverage_CopyTable"]
            </Button>
            <span aria-live="polite" class="resolution-coverage-copied" role="status">
                @if (_showCopied)
                {
                    <span class="resolution-coverage-copied-chip">@Localizer["Coverage_Copied"]</span>
                }
            </span>
        </div>
    }
</ExtraFooterContent>
</ModalChrome>
