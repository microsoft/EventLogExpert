@inherits AppStateComponentBase
@{
    var presentation = Source.Current;

    if (!ReferenceEquals(presentation, _renderedPresentation))
    {
        _tabRows = BuildTabRows(presentation);
        _renderedPresentation = presentation;
    }

    var tabRows = _tabRows;
}

<div class="log-tab-bar" data-pane="table" hidden="@(!presentation.HasMultipleTabs)" @ref="_logTabBarRootRef">
    <div class="tab-row">
        @foreach (var row in tabRows)
        {
            if (row is AllLogsRow allLogs)
            {
                <div class="@GetActiveTab(presentation, allLogs.Header) all-logs" data-tooltip="@GetTabTooltip(allLogs.Header)"
                    @oncontextmenu="OpenAllLogsMenu"
                    @oncontextmenu:preventDefault="true"
                    @oncontextmenu:stopPropagation="true">
                    <span aria-describedby="@($"tab-tip-{allLogs.Header.Id.Value:N}")"
                        @onkeydown="e => OnTabKeyDown(e, allLogs.Header)"
                        @onmousedown="e => OnTabMouseDown(e, allLogs.Header)"
                        role="button"
                        tabindex="0">
                        @GetTabName(presentation, allLogs.Header)
                    </span>
                    <span class="visually-hidden" id="@($"tab-tip-{allLogs.Header.Id.Value:N}")">@GetTabTooltip(allLogs.Header)</span>
                </div>
            }
            else if (row is GroupRow group)
            {
                <div class="tab-group" style="--group-color: var(--cat-color-@(GetGroupColorIndex(group.Group.Id)));">
                    <div class="@GetActiveTab(presentation, group.Header) group-header" data-tooltip="@GetTabTooltip(group.Header)"
                        @oncontextmenu="args => OpenGroupHeaderMenu(args, group.Group)"
                        @oncontextmenu:preventDefault="true"
                        @oncontextmenu:stopPropagation="true">
                        <button aria-describedby="@($"tab-tip-{group.Header.Id.Value:N}")"
                            aria-expanded="@(presentation.ActiveTabId == group.Header.Id ? (group.Group.IsCollapsed ? "false" : "true") : null)"
                            class="group-header-label"
                            @onclick="() => ActivateOrToggleGroup(group)"
                            type="button">
                            @GetTabName(presentation, group.Header)
                        </button>
                        <span class="visually-hidden" id="@($"tab-tip-{group.Header.Id.Value:N}")">@GetTabTooltip(group.Header)</span>
                        <i aria-label="@Localizer["TabBar_CloseGroup"]"
                            class="bi bi-x-circle"
                            data-tooltip="@Localizer["TabBar_CloseGroup"]"
                            @onclick="() => CloseGroup(group.Group)"
                            @onkeydown="e => OnCloseGroupKeyDown(e, group.Group)"
                            role="button"
                            tabindex="0">
                        </i>
                    </div>
                    @foreach (var member in VisibleMembers(presentation, group))
                    {
                        <div class="@GetTabClass(presentation, member, true)" data-tooltip="@GetTabTooltip(member)"
                            @oncontextmenu="args => OpenMemberMenu(args, member, group.Group)"
                            @oncontextmenu:preventDefault="true"
                            @oncontextmenu:stopPropagation="true">
                            <span aria-describedby="@($"tab-tip-{member.Id.Value:N}")"
                                aria-disabled="@(member.IsLoading ? "true" : null)"
                                @onkeydown="e => OnTabKeyDown(e, member)"
                                @onmousedown="e => OnTabMouseDown(e, member)"
                                role="button"
                                tabindex="@(member.IsLoading ? -1 : 0)">
                                @if (member.IsLoading)
                                {
                                    <i aria-label="@Localizer["TabBar_LoadingAria"]" class="loader-spin spinner-border" role="status"></i>
                                    @:&nbsp;
                                }
                                @GetTabName(presentation, member)
                            </span>
                            <span class="visually-hidden" id="@($"tab-tip-{member.Id.Value:N}")">@GetTabTooltip(member)</span>
                            <i aria-label="@Localizer["TabBar_CloseLogAria"]"
                                class="bi bi-x-circle"
                                data-tooltip="@Localizer["TabBar_CloseLogAria"]"
                                @onkeydown="e => OnCloseLogKeyDown(e, member)"
                                @onmousedown="e => OnCloseLogMouseDown(e, member)"
                                role="button"
                                tabindex="0">
                            </i>
                        </div>
                    }
                </div>
            }
            else if (row is StandaloneRow standalone)
            {
                <div class="@GetActiveTab(presentation, standalone.Tab)" data-tooltip="@GetTabTooltip(standalone.Tab)"
                    @oncontextmenu="args => OpenStandaloneMenu(args, standalone.Tab)"
                    @oncontextmenu:preventDefault="true"
                    @oncontextmenu:stopPropagation="true">
                    <span aria-describedby="@($"tab-tip-{standalone.Tab.Id.Value:N}")"
                        aria-disabled="@(standalone.Tab.IsLoading ? "true" : null)"
                        @onkeydown="e => OnTabKeyDown(e, standalone.Tab)"
                        @onmousedown="e => OnTabMouseDown(e, standalone.Tab)"
                        role="button"
                        tabindex="@(standalone.Tab.IsLoading ? -1 : 0)">
                        @if (standalone.Tab.IsLoading)
                        {
                            <i aria-label="@Localizer["TabBar_LoadingAria"]" class="loader-spin spinner-border" role="status"></i>
                            @:&nbsp;
                        }
                        @GetTabName(presentation, standalone.Tab)
                    </span>
                    <span class="visually-hidden" id="@($"tab-tip-{standalone.Tab.Id.Value:N}")">@GetTabTooltip(standalone.Tab)</span>
                    <i aria-label="@Localizer["TabBar_CloseLogAria"]"
                        class="bi bi-x-circle"
                        data-tooltip="@Localizer["TabBar_CloseLogAria"]"
                        @onkeydown="e => OnCloseLogKeyDown(e, standalone.Tab)"
                        @onmousedown="e => OnCloseLogMouseDown(e, standalone.Tab)"
                        role="button"
                        tabindex="0">
                    </i>
                </div>
            }
        }
    </div>
</div>
