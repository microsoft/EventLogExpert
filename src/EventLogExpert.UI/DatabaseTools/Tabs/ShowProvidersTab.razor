@using EventLogExpert.DatabaseTools.ShowProviders
@inherits DatabaseToolsTabBase<ShowProvidersRequest>

<div class="db-tab show-providers-tab">
    <div class="db-tab-form">
        <div class="form-row">
            <label for="show-source-path">@Localizer["DatabaseTools_Field_SourcePath"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="show-source-path-help">
                    @Localizer["Db_Show_SourceHelp"]
                </span>
                <input aria-describedby="show-source-path-help"
                    @bind-value="_sourcePath"
                    @bind-value:event="oninput"
                    class="input source-path"
                    disabled="@IsRunning"
                    id="show-source-path"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Source"]"
                    type="text" />
                <Button Disabled="@IsRunning" OnClick="PickSourceAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        @if (ShowProtectedProvidersOption)
        {
            <div class="form-row">
                <label class="checkbox-label" for="show-include-protected">
                    <input checked="@_includeProtectedProviders"
                        disabled="@IsRunning"
                        id="show-include-protected"
                        @onchange="OnIncludeProtectedProvidersInput"
                        type="checkbox" />
                    @Localizer["DatabaseTools_IncludeProtectedProviders"]
                </label>
            </div>
        }

        <div class="form-row">
            <label for="show-filter">@Localizer["DatabaseTools_Field_FilterRegex"]</label>
            <input aria-describedby="@(_filterError is null ? "show-filter-help" : "show-filter-help show-filter-error")"
                aria-invalid="@(_filterError is not null ? "true" : "false")"
                class="@FilterCssClass"
                disabled="@IsRunning"
                id="show-filter"
                @oninput="OnFilterInput"
                placeholder="@Localizer["DatabaseTools_Filter_Placeholder", "^Microsoft-.*"]"
                type="text"
                value="@_filterText" />
            <span class="db-tab-help" id="show-filter-help">
                @Localizer["DatabaseTools_Filter_Help"]
            </span>

            @if (_filterError is not null)
            {
                <span class="filter-error" id="show-filter-error" role="alert">
                    <i aria-hidden="true" class="bi bi-exclamation-triangle"></i>
                    <span>@_filterError</span>
                </span>
            }
        </div>
    </div>

    <DatabaseToolsLogView Entries="@LogEntries" FileNamePrefix="show-providers" Outcome="@Outcome">
        <ToolbarLeadingContent>
            @if (IsRunning)
            {
                @if (IsCancelling)
                {
                    <Button Disabled IconClass="bi bi-hourglass-split">@Localizer["DatabaseTools_Action_Cancelling"]</Button>
                }
                else
                {
                    <DangerButton IconClass="bi bi-x-circle" OnClick="CancelRun">@Localizer["Modal_Cancel"]</DangerButton>
                }
            }
            else
            {
                @if (WillElevate)
                {
                    <span class="visually-hidden" id="show-run-elevation-help">@RunElevationTitle</span>
                }

                <PrimaryButton Disabled="@(!CanRun)"
                    IconClass="@(WillElevate ? "bi bi-shield-lock" : "bi bi-play-fill")"
                    OnClick="RunShowAsync"
                    aria-describedby="@(WillElevate ? "show-run-elevation-help" : null)"
                    data-tooltip="@(CanRun ? RunElevationTitle : null)"
                    title="@(CanRun ? null : RunElevationTitle)">
                    @Localizer["DatabaseTools_Action_Run"]
                </PrimaryButton>
            }
        </ToolbarLeadingContent>
    </DatabaseToolsLogView>
</div>
