@using EventLogExpert.DatabaseTools.CreateDatabase
@inherits DatabaseToolsTabBase<CreateDatabaseRequest>

<div class="create-database-tab db-tab">
    <div class="db-tab-form">
        <div class="form-row">
            <label for="create-target-path">@Localizer["DatabaseTools_Field_TargetDb"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="create-target-path-help">@Localizer["Db_Create_TargetHelp"]</span>
                <input aria-describedby="create-target-path-help"
                    class="input target-path"
                    disabled="@IsRunning"
                    id="create-target-path"
                    @oninput="OnTargetPathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Output"]"
                    type="text"
                    value="@_targetPath" />
                <Button Disabled="@IsRunning" OnClick="PickTargetAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        <div class="form-row">
            <label for="create-source-path">@Localizer["DatabaseTools_Field_SourcePath"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="create-source-path-help">
                    @Localizer["Db_Create_SourceHelp"]
                </span>
                <input aria-describedby="create-source-path-help"
                    class="input source-path"
                    disabled="@IsRunning"
                    id="create-source-path"
                    @oninput="OnSourcePathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Source"]"
                    type="text"
                    value="@_sourcePath" />
                <Button Disabled="@IsRunning" OnClick="PickSourceAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        @if (ShowProtectedProvidersOption)
        {
            <div class="form-row">
                <label class="checkbox-label" for="create-include-protected">
                    <input checked="@_includeProtectedProviders"
                        disabled="@IsRunning"
                        id="create-include-protected"
                        @onchange="OnIncludeProtectedProvidersInput"
                        type="checkbox" />
                    @Localizer["DatabaseTools_IncludeProtectedProviders"]
                </label>
            </div>
        }

        @if (_sourceIsExistingDirectory)
        {
            <div class="form-row">
                <label class="checkbox-label" for="create-folder-as-image">
                    <input checked="@_treatFolderAsImage"
                        disabled="@IsRunning"
                        id="create-folder-as-image"
                        @onchange="OnTreatFolderAsImageInput"
                        type="checkbox" />
                    @Localizer["Db_Create_FolderIsOfflineImage"]
                </label>
            </div>
        }

        @if (IsWimIndexApplicable)
        {
            <div class="form-row">
                <label for="create-wim-index" id="create-wim-index-label">@Localizer["Db_Create_ImageIndex"]</label>
                <div class="path-input-group">
                    <span class="db-tab-help" id="create-wim-index-help">@Localizer["Db_Create_ImageIndexHelp"]</span>
                    <ValueSelect AriaDescribedBy="@(_editionsError is null ? "create-wim-index-help" : "create-wim-index-help create-wim-index-error")"
                        AriaInvalid="@(_editionsError is null ? "false" : "true")"
                        AriaLabelledBy="create-wim-index-label"
                        CssClass="input wim-index"
                        Disabled="@IsRunning"
                        Id="create-wim-index"
                        IsInput="true"
                        T="int?"
                        ToStringFunc="FormatSelectedImageIndex"
                        @bind-Value="_wimIndex">
                        @foreach (var edition in _imageEditions)
                        {
                            <ValueSelectItem T="int?" Value="edition.Index">@FormatEditionLabel(edition)</ValueSelectItem>
                        }
                    </ValueSelect>
                    @if (IsRunning || _isLoadingEditions)
                    {
                        <span class="visually-hidden" id="create-load-editions-help">@Localizer["Db_Create_LoadEditionsTitle"]</span>
                    }
                    <Button Disabled="@(IsRunning || _isLoadingEditions)"
                        OnClick="LoadEditionsAsync"
                        aria-describedby="@(IsRunning || _isLoadingEditions ? "create-load-editions-help" : null)"
                        data-tooltip="@Localizer["Db_Create_LoadEditionsTitle"]">
                        @(_isLoadingEditions ? Localizer["Db_Create_LoadingEditions"] : Localizer["Db_Create_LoadEditions"])
                    </Button>
                </div>

                @if (_editionsError is not null)
                {
                    <span class="filter-error" id="create-wim-index-error" role="alert">
                        <i aria-hidden="true" class="bi bi-exclamation-triangle"></i>
                        <span>@_editionsError</span>
                    </span>
                }
            </div>
        }

        <div class="form-row">
            <label for="create-filter">@Localizer["DatabaseTools_Field_FilterRegex"]</label>
            <input aria-describedby="@(_filterError is null ? "create-filter-help" : "create-filter-help create-filter-error")"
                aria-invalid="@(_filterError is not null ? "true" : "false")"
                class="@FilterCssClass"
                disabled="@IsRunning"
                id="create-filter"
                @oninput="OnFilterInput"
                placeholder="@Localizer["DatabaseTools_Filter_Placeholder", "^Microsoft-.*"]"
                type="text"
                value="@_filterText" />
            <span class="db-tab-help" id="create-filter-help">@Localizer["DatabaseTools_Filter_Help"]</span>

            @if (_filterError is not null)
            {
                <span class="filter-error" id="create-filter-error" role="alert">
                    <i aria-hidden="true" class="bi bi-exclamation-triangle"></i>
                    <span>@_filterError</span>
                </span>
            }
        </div>

        <div class="form-row">
            <label for="create-skip-path">@Localizer["Db_Create_SkipProvidersFrom"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="create-skip-path-help">
                    @Localizer["Db_Create_SkipProvidersHelp"]
                </span>
                <input aria-describedby="create-skip-path-help"
                    class="input skip-path"
                    disabled="@IsRunning"
                    id="create-skip-path"
                    @oninput="OnSkipPathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Source"]"
                    type="text"
                    value="@_skipPath" />
                <Button Disabled="@IsRunning" OnClick="PickSkipAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        <div class="form-row">
            <label for="create-auto-import" id="create-auto-import-label">@Localizer["DatabaseTools_Field_WhenFinished"]</label>
            <ValueSelect AriaLabelledBy="create-auto-import-label"
                CssClass="input"
                Disabled="@IsRunning"
                Id="create-auto-import"
                T="AutoImportMode"
                ToStringFunc="FormatAutoImportMode"
                @bind-Value="AutoImportMode">
                <ValueSelectItem T="AutoImportMode"
                    Value="AutoImportMode.Off">
                    @AutoImportModeLocalizer.Label(Localizer, AutoImportMode.Off)
                </ValueSelectItem>
                <ValueSelectItem T="AutoImportMode"
                    Value="AutoImportMode.Import">
                    @AutoImportModeLocalizer.Label(Localizer, AutoImportMode.Import)
                </ValueSelectItem>
                <ValueSelectItem T="AutoImportMode"
                    Value="AutoImportMode.ImportAndEnable">
                    @AutoImportModeLocalizer.Label(Localizer, AutoImportMode.ImportAndEnable)
                </ValueSelectItem>
            </ValueSelect>
        </div>
    </div>

    <DatabaseToolsLogView Entries="@LogEntries" FileNamePrefix="create-database" Outcome="@Outcome">
        <ToolbarLeadingContent>
            @if (IsRunning && !IsImportInProgress)
            {
                @if (IsCancelling)
                {
                    <Button Disabled IconClass="bi bi-hourglass-split">
                        @Localizer["DatabaseTools_Action_Cancelling"]
                    </Button>
                }
                else
                {
                    <DangerButton IconClass="bi bi-x-circle" OnClick="CancelRun">
                        @Localizer["Modal_Cancel"]
                    </DangerButton>
                }
            }
            else
            {
                @if (WillElevate)
                {
                    <span class="visually-hidden" id="create-run-elevation-help">@RunElevationTitle</span>
                }

                <PrimaryButton Disabled="@(!CanRun || IsRunning || IsImportInProgress || IsConfirming)"
                    IconClass="@(WillElevate ? "bi bi-shield-lock" : "bi bi-play-fill")"
                    OnClick="RunCreateAsync"
                    aria-describedby="@(WillElevate ? "create-run-elevation-help" : null)"
                    data-tooltip="@RunElevationTitle">
                    @Localizer["DatabaseTools_Action_Run"]
                </PrimaryButton>
            }
        </ToolbarLeadingContent>
        <ToolbarTrailingContent>
            @if (ShouldShowImportDatabaseButton)
            {
                <Button Disabled="@IsImportDatabaseButtonDisabled" IconClass="bi bi-database-add" OnClick="ImportProducedDatabaseAsync">
                    @ImportDatabaseButtonText
                </Button>
            }
        </ToolbarTrailingContent>
    </DatabaseToolsLogView>
</div>
