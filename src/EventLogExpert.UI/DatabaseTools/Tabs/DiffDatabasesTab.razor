@using EventLogExpert.DatabaseTools.DiffDatabase
@inherits DatabaseToolsTabBase<DiffDatabaseRequest>

<div class="db-tab diff-databases-tab">
    <div class="db-tab-form">
        <div class="form-row">
            <label for="diff-first-path">@Localizer["Db_Diff_FirstSource"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="diff-first-path-help">@Localizer["Db_Diff_FirstSourceHelp"]</span>
                <input aria-describedby="diff-first-path-help"
                    class="input source-path"
                    disabled="@IsRunning"
                    id="diff-first-path"
                    @oninput="OnFirstPathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Source"]"
                    type="text"
                    value="@_firstPath" />
                <Button Disabled="@IsRunning" OnClick="PickFirstAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        <div class="form-row">
            <label for="diff-second-path">@Localizer["Db_Diff_SecondSource"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="diff-second-path-help">@Localizer["Db_Diff_SecondSourceHelp"]</span>
                <input aria-describedby="diff-second-path-help"
                    class="input source-path"
                    disabled="@IsRunning"
                    id="diff-second-path"
                    @oninput="OnSecondPathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Source"]"
                    type="text"
                    value="@_secondPath" />
                <Button Disabled="@IsRunning" OnClick="PickSecondAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        <div class="form-row">
            <label>@Localizer["Db_Diff_Result"]</label>
            <span aria-label="@Localizer["Db_Diff_ResultDirectionAria"]" class="direction-row">@Localizer["Db_Diff_ResultDirection"]</span>
        </div>

        <div class="form-row">
            <label for="diff-new-db">@Localizer["Db_Diff_NewDbOutput"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="diff-new-db-help">@Localizer["Db_Diff_NewDbHelp"]</span>
                <input aria-describedby="diff-new-db-help"
                    class="input target-path"
                    disabled="@IsRunning"
                    id="diff-new-db"
                    @oninput="OnNewDbPathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Output"]"
                    type="text"
                    value="@_newDbPath" />
                <Button Disabled="@IsRunning" OnClick="PickNewDbAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>
    </div>

    <DatabaseToolsLogView Entries="@LogEntries" FileNamePrefix="diff-databases" Outcome="@Outcome">
        <ToolbarLeadingContent>
            @if (IsRunning)
            {
                @if (IsCancelling)
                {
                    <Button Disabled IconClass="bi bi-hourglass-split">@Localizer["DatabaseTools_Action_Cancelling"]</Button>
                }
                else
                {
                    <DangerButton IconClass="bi bi-x-circle" OnClick="CancelRun">@Localizer["Modal_Cancel"]</DangerButton>
                }
            }
            else
            {
                <PrimaryButton Disabled="@(!CanRun)" IconClass="bi bi-play-fill" OnClick="RunAsync">@Localizer["DatabaseTools_Action_Run"]</PrimaryButton>
            }
        </ToolbarLeadingContent>
    </DatabaseToolsLogView>
</div>
