@using EventLogExpert.DatabaseTools.UpgradeDatabase
@inherits DatabaseToolsTabBase<UpgradeDatabaseRequest>

<div class="db-tab upgrade-database-tab">
    <div class="db-tab-form">
        <div class="form-row">
            <label for="upgrade-db-path">@Localizer["Db_Upgrade_DatabaseLabel"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="upgrade-db-path-help">@Localizer["Db_Upgrade_DatabaseHelp"]</span>
                <input aria-describedby="upgrade-db-path-help"
                    class="input target-path"
                    disabled="@IsRunning"
                    id="upgrade-db-path"
                    @oninput="OnDbPathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_ExistingDatabase"]"
                    type="text"
                    value="@_dbPath" />
                <Button Disabled="@IsRunning" OnClick="PickDbAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>
    </div>

    <DatabaseToolsLogView Entries="@LogEntries" FileNamePrefix="upgrade-database" Outcome="@Outcome">
        <ToolbarLeadingContent>
            @if (IsRunning)
            {
                @if (IsCancelling)
                {
                    <Button Disabled IconClass="bi bi-hourglass-split">@Localizer["DatabaseTools_Action_Cancelling"]</Button>
                }
                else
                {
                    <DangerButton IconClass="bi bi-x-circle" OnClick="CancelRun">@Localizer["Modal_Cancel"]</DangerButton>
                }
            }
            else
            {
                <PrimaryButton Disabled="@(!CanRun)" IconClass="bi bi-play-fill" OnClick="RunAsync">@Localizer["DatabaseTools_Action_Run"]</PrimaryButton>
            }
        </ToolbarLeadingContent>
    </DatabaseToolsLogView>
</div>
