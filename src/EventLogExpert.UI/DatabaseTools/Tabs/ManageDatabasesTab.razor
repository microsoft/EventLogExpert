@namespace EventLogExpert.UI.DatabaseTools.Tabs

<div class="manage-databases-tab">
    @if (IsClassificationPending)
    {
        <div class="manage-status-banner manage-status-banner--info" role="status">
            <i aria-hidden="true" class="bi bi-arrow-repeat loader-spin manage-status-banner__spinner"></i>
            <span class="manage-status-banner__message">@Localizer["Db_Manage_ClassifyingDatabases"]</span>
        </div>
    }

    <span aria-atomic="true" aria-live="polite" class="visually-hidden" role="status">@_selectionAnnouncement</span>

    <div class="manage-databases-import-row">
        @if (DatabaseService.Entries.Count > 0)
        {
            <Button CssClass="manage-databases-select-btn"
                IconClass="bi bi-check2-square"
                OnClick="ToggleSelectionMode"
                aria-pressed="@(_isSelectionModeActive ? "true" : "false")"
                id="manage-select-button"
                @ref="_selectButton">
                @(_isSelectionModeActive ? Localizer["Db_Manage_Select_Done"] : Localizer["Db_Manage_Select_Select"])
            </Button>
        }
        <Button CssClass="manage-databases-import-btn"
            IconClass="bi bi-plus-circle"
            OnClick="ImportDatabase"
            id="manage-import-button"
            @ref="_importButton">
            @Localizer["Db_Manage_ImportDatabase"]
        </Button>
    </div>

    @if (_isSelectionModeActive && DatabaseService.Entries.Count > 0)
    {
        <div class="manage-databases-selection-header">
            <div class="manage-databases-master-checkbox">
                <ChromelessButton CssClass="manage-databases-master-btn"
                    IconClass="@($"bi {MasterCheckboxIconClass}")"
                    OnClick="OnMasterCheckboxClickAsync"
                    aria-checked="@MasterCheckboxAriaChecked"
                    aria-label="@MasterCheckboxAriaLabel"
                    @ref="_masterCheckbox"
                    role="checkbox" />
            </div>
            <span class="manage-databases-selection-count">
                @Localizer["Db_Manage_SelectionCount", _selectedForBulk.Count, DatabaseService.Entries.Count]
                @if (_selectedForBulk.Count > 0)
                {
                    <span class="manage-databases-selection-count-eligible">
                        @Localizer["Db_Manage_EligibleForUpgrade", _eligibleUpgradeCount]
                    </span>
                }
            </span>
        </div>
    }

    <div class="manage-databases-entries">
        @if (DatabaseService.Entries.Count > 0)
        {
            @foreach (var entry in DatabaseService.Entries)
            {
                <DatabaseEntryRow EffectiveEnabled="GetEffectiveEnabled(entry)"
                    Entry="@entry"
                    IsClassificationPending="@IsClassificationPending"
                    IsSelected="@_selectedForBulk.Contains(entry.FileName)"
                    IsSelectionModeActive="@_isSelectionModeActive"
                    IsTogglePending="@_pendingToggles.ContainsKey(entry.FileName)"
                    IsUpgradeBlocked="@IsUpgradeBlocked"
                    IsUpgrading="@Coordinator.IsUpgradeInFlight(entry.FileName)"
                    OnRemove="@(() => RemoveDatabase(entry))"
                    OnRestoreFromBackup="@(() => RestoreFromBackup(entry))"
                    OnRetryClassification="@(() => RetryClassification(entry))"
                    OnSelectionToggle="@(() => ToggleSelection(entry.FileName))"
                    OnToggle="@(() => ToggleDatabase(entry.FileName))"
                    OnUpgrade="@(() => UpgradeEntry(entry.FileName))"
                    UpgradeProgress="@GetUpgradeProgressForEntry(entry)"
                    @key="entry.FileName"
                    @ref="_rowRefs[entry.FileName]" />
            }
        }
        else if (!IsClassificationPending)
        {
            <ManageDatabasesEmptyState />
        }
    </div>

    @if (_isSelectionModeActive && _selectedForBulk.Count > 0)
    {
        <div aria-label="@Localizer["Db_Manage_BulkActionsAria"]" class="manage-databases-bulk-strip" role="group">
            <span class="manage-databases-bulk-count">
                @Localizer["Db_Manage_SelectedCount", _selectedForBulk.Count]
            </span>
            @if (_eligibleUpgradeCount > 0)
            {
                <PrimaryButton Disabled="@IsUpgradeBlocked"
                    OnClick="OnBulkUpgradeClickAsync"
                    aria-describedby="@(IsUpgradeBlocked ? _upgradeBlockedHelpId : null)"
                    @ref="_bulkUpgradeButton">
                    @Localizer["Db_Manage_UpgradeCount", _eligibleUpgradeCount]
                </PrimaryButton>
            }
            <DangerButton OnClick="OnBulkRemoveClickAsync"
                @ref="_bulkRemoveButton">
                @Localizer["Db_Manage_RemoveCount", _selectedForBulk.Count]
            </DangerButton>
            <span class="visually-hidden" id="@_upgradeBlockedHelpId">
                @(IsUpgradeBlocked ? Localizer["Db_Manage_CannotUpgradeInProgress"] : string.Empty)
            </span>
        </div>
    }

    @if (HasPendingChanges)
    {
        <div aria-label="@Localizer["Db_Manage_PendingChangesAria"]" class="manage-databases-save-strip" role="group">
            <span class="manage-databases-pending-count">
                @LocalizedCount.OneOrManyRaw(Localizer, _pendingToggles.Count, "Db_Manage_PendingChange_One", "Db_Manage_PendingChange_Many")
            </span>
            <Button OnClick="DiscardPending">
                @Localizer["Db_Manage_Discard"]
            </Button>
            <PrimaryButton Disabled="@IsUpgradeBlocked"
                OnClick="OnSaveClickAsync"
                aria-describedby="@(IsUpgradeBlocked ? _saveBlockedHelpId : null)"
                id="manage-save">
                @Localizer["Db_Manage_SaveChanges"]
            </PrimaryButton>
            <span class="visually-hidden" id="@_saveBlockedHelpId">
                @(IsUpgradeBlocked ? Localizer["Db_Manage_CannotSaveInProgress"] : string.Empty)
            </span>
        </div>
    }
</div>
