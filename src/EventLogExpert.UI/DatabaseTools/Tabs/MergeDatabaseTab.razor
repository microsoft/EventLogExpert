@using EventLogExpert.DatabaseTools.MergeDatabase
@inherits DatabaseToolsTabBase<MergeDatabaseRequest>

<div class="db-tab merge-database-tab">
    <div class="db-tab-form">
        <div class="form-row">
            <label for="merge-source-path">@Localizer["Db_Merge_Source"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="merge-source-path-help">
                    @Localizer["Db_Merge_SourceHelp"]
                </span>
                <input aria-describedby="merge-source-path-help"
                    class="input source-path"
                    disabled="@IsRunning"
                    id="merge-source-path"
                    @oninput="OnSourcePathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_Source"]"
                    type="text"
                    value="@_sourcePath" />
                <Button Disabled="@IsRunning" OnClick="PickSourceAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        <div class="form-row">
            <label for="merge-target-path">@Localizer["DatabaseTools_Field_TargetDb"]</label>
            <div class="path-input-group">
                <span class="db-tab-help" id="merge-target-path-help">@Localizer["Db_Merge_TargetHelp"]</span>
                <input aria-describedby="merge-target-path-help"
                    class="input target-path"
                    disabled="@IsRunning"
                    id="merge-target-path"
                    @oninput="OnTargetPathInput"
                    placeholder="@Localizer["DatabaseTools_PathInput_Placeholder_ExistingDatabase"]"
                    type="text"
                    value="@_targetPath" />
                <Button Disabled="@IsRunning" OnClick="PickTargetAsync">@Localizer["DatabaseTools_Action_Browse"]</Button>
            </div>
        </div>

        <div class="form-row">
            <label for="merge-overwrite-mode" id="merge-overwrite-mode-label">@Localizer["Db_Merge_ExistingProviders"]</label>
            <ValueSelect AriaLabelledBy="merge-overwrite-mode-label"
                CssClass="input filter-dropdown overwrite-mode-select"
                T="MergeOverwriteMode"
                ToStringFunc="FormatOverwriteMode"
                @bind-Value="_overwriteMode">
                <ValueSelectItem T="MergeOverwriteMode"
                    Value="MergeOverwriteMode.Keep">
                    @MergeOverwriteModeLocalizer.Label(Localizer, MergeOverwriteMode.Keep)
                </ValueSelectItem>
                <ValueSelectItem T="MergeOverwriteMode"
                    Value="MergeOverwriteMode.Overwrite">
                    @MergeOverwriteModeLocalizer.Label(Localizer, MergeOverwriteMode.Overwrite)
                </ValueSelectItem>
            </ValueSelect>
        </div>

        <div class="form-row">
            <label for="merge-auto-import" id="merge-auto-import-label">@Localizer["DatabaseTools_Field_WhenFinished"]</label>
            <ValueSelect AriaLabelledBy="merge-auto-import-label"
                CssClass="input"
                Id="merge-auto-import"
                T="AutoImportMode"
                ToStringFunc="FormatAutoImportMode"
                @bind-Value="AutoImportMode">
                <ValueSelectItem T="AutoImportMode"
                    Value="AutoImportMode.Off">
                    @AutoImportModeLocalizer.Label(Localizer, AutoImportMode.Off)
                </ValueSelectItem>
                <ValueSelectItem T="AutoImportMode"
                    Value="AutoImportMode.Import">
                    @AutoImportModeLocalizer.Label(Localizer, AutoImportMode.Import)
                </ValueSelectItem>
                <ValueSelectItem T="AutoImportMode"
                    Value="AutoImportMode.ImportAndEnable">
                    @AutoImportModeLocalizer.Label(Localizer, AutoImportMode.ImportAndEnable)
                </ValueSelectItem>
            </ValueSelect>
        </div>
    </div>

    <DatabaseToolsLogView Entries="@LogEntries" FileNamePrefix="merge-database" Outcome="@Outcome">
        <ToolbarLeadingContent>
            @if (IsRunning && !IsImportInProgress)
            {
                @if (IsCancelling)
                {
                    <Button Disabled IconClass="bi bi-hourglass-split">@Localizer["DatabaseTools_Action_Cancelling"]</Button>
                }
                else
                {
                    <DangerButton IconClass="bi bi-x-circle" OnClick="CancelRun">@Localizer["Modal_Cancel"]</DangerButton>
                }
            }
            else
            {
                @if (RunDisabledReason is not null)
                {
                    <span class="visually-hidden" id="merge-run-disabled-help">@RunDisabledReason</span>
                }

                <PrimaryButton Disabled="@(!CanRun || IsRunning || IsImportInProgress || IsConfirming)"
                    IconClass="bi bi-play-fill"
                    OnClick="RunAsync"
                    aria-describedby="@(RunDisabledReason is null ? null : "merge-run-disabled-help")"
                    data-tooltip="@RunDisabledReason">
                    @Localizer["DatabaseTools_Action_Run"]
                </PrimaryButton>
            }
        </ToolbarLeadingContent>
        <ToolbarTrailingContent>
            @if (ShouldShowImportDatabaseButton)
            {
                <Button Disabled="@IsImportDatabaseButtonDisabled" IconClass="bi bi-database-add" OnClick="ImportProducedDatabaseAsync">
                    @ImportDatabaseButtonText
                </Button>
            }
        </ToolbarTrailingContent>
    </DatabaseToolsLogView>
</div>
