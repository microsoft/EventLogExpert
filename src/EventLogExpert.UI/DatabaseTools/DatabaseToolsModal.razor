@using EventLogExpert.UI.DatabaseTools.Tabs
@inherits ModalBase<bool>

<ModalChrome AriaLabel="@Localizer["DatabaseTools_AriaLabel"]"
    BodyLayout="ModalBodyLayout.Flex"
    Footer="FooterPreset.CloseOnly"
    Height="80%"
    InlineAlert="@CurrentInlineAlert"
    MaxWidth="min(80rem, calc(100vw - 2rem))"
    MinWidth="min(80rem, calc(100vw - 2rem))"
    OnCancel="HandleCancelButtonClickAsync"
    OnClose="HandleCancelButtonClickAsync"
    OnDialogClosedByUser="HandleDialogClosedByUserAsync"
    OnInlineAlertResolved="HandleInlineAlertResolvedAsync"
    @ref="ChromeRef">
    <ChildContent>
        <CascadingValue Name="VerboseLogging" Value="_verboseLogging">
            <CascadingValue IsFixed="true" Value="(IInlineAlertSurface)this">
                <CascadingValue Name="RequestAutoImport" Value="HandleAutoImportAsync">
                    <div class="db-tabs-container">
                        <SidebarTabs TTab="DatabaseToolsTab"
                            TablistAriaLabel="@Localizer["DatabaseTools_TablistAriaLabel"]"
                            Tabs="[.. s_tabs.Select(tab => (tab, DatabaseToolsTabLocalizer.Label(Localizer, tab)))]"
                            @bind-ActiveTab="_activeTab">
                            <TabContent Context="tab">
                                @switch (tab)
                                {
                                    case DatabaseToolsTab.Show:
                                        <ShowProvidersTab @ref="_showTab" />

                                        break;
                                    case DatabaseToolsTab.Create:
                                        <CreateDatabaseTab @ref="_createTab" />

                                        break;
                                    case DatabaseToolsTab.Merge:
                                        <MergeDatabaseTab @ref="_mergeTab" />

                                        break;
                                    case DatabaseToolsTab.Diff:
                                        <DiffDatabasesTab @ref="_diffTab" />

                                        break;
                                    case DatabaseToolsTab.Upgrade:
                                        <UpgradeDatabaseTab @ref="_upgradeTab" />

                                        break;
                                    case DatabaseToolsTab.Manage:
                                        <ManageDatabasesTab @ref="_manageTab" />

                                        break;
                                }
                            </TabContent>
                        </SidebarTabs>
                    </div>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </ChildContent>
    <ExtraFooterContent>
        <div aria-labelledby="verbose-mode-label" class="verbose-mode" role="group">
            <span class="verbose-mode-label" id="verbose-mode-label">@Localizer["DatabaseTools_OutputLabel"]</span>
            <OptionSelect AriaDescribedBy="verbose-mode-help"
                AriaLabelledBy="verbose-mode-label"
                DisabledString="@Localizer["DatabaseTools_Output_Normal"]"
                EnabledString="@Localizer["DatabaseTools_Output_Verbose"]"
                @bind-Value="_verboseLogging" />
            <span class="visually-hidden" id="verbose-mode-help">
                @Localizer["DatabaseTools_Output_VerboseHelp"]
            </span>
        </div>
    </ExtraFooterContent>
</ModalChrome>
