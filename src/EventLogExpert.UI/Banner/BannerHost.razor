@if (RendersContent)
{
    IReadOnlyList<BannerCycleItem> items = CycleState.Items;
    BannerView view = CycleState.CurrentView;
    int displayedIndex = CycleState.DisplayedIndex;

    Exception? currentCritical = CriticalErrorService.CurrentCritical;
    IReadOnlyList<ErrorBannerEntry> errors = ErrorBannerService.ErrorBanners;
    IReadOnlyList<BannerInfoEntry> infos = InfoBannerService.InfoBanners;
    Dictionary<BannerId, ErrorBannerEntry> errorsById = errors.ToDictionary(entry => entry.Id);
    Dictionary<BannerId, BannerInfoEntry> infosById = infos.ToDictionary(entry => entry.Id);
    IReadOnlyList<DatabaseEntry> attentionEntries = AttentionBannerService.AttentionEntries;
    BannerProgressEntry? backgroundProgress = ProgressBannerService.BackgroundProgress;
    ExportProgressEntry? exportProgress = ExportProgressBannerService.CurrentExport;

    bool showCyclePagination = !ShowAllEntries && !CriticalOnly && items.Count > 1 && view != BannerView.Critical;

    IEnumerable<BannerCycleItem> displayedItems = CriticalOnly ? items.Where(item => item.View == BannerView.Critical) :
        ShowAllEntries ? items.Where(item => item.View != BannerView.Critical) :
        CycleState.SelectedItem is { } selectedItem ? [selectedItem] : [];

    RenderFragment cycleNav = @<text>
                                   @if (showCyclePagination)
                                   {
                                       <span class="banner-pagination">@Localizer["Banner_Pagination", displayedIndex + 1, items.Count]</span>

                                       <Button CssClass="banner-cycle-prev"
                                           Disabled="@(displayedIndex == 0)"
                                           IconClass="bi bi-chevron-left"
                                           OnClick="CycleState.MovePrev"
                                           aria-label='@Localizer["Banner_Nav_PreviousAria"]' />

                                       <Button CssClass="banner-cycle-next"
                                           Disabled="@(displayedIndex == items.Count - 1)"
                                           IconClass="bi bi-chevron-right"
                                           OnClick="CycleState.MoveNext"
                                           aria-label='@Localizer["Banner_Nav_NextAria"]' />
                                   }
                               </text>;

    @foreach (BannerCycleItem selected in displayedItems)
    {
        ErrorBannerEntry? error = selected.EntryId is { } errorId ? errorsById.GetValueOrDefault(errorId) : null;
        BannerInfoEntry? info = selected.EntryId is { } infoId ? infosById.GetValueOrDefault(infoId) : null;

        string staticSeverityText = selected.View switch
        {
            BannerView.Error => Localizer["Notifications_Severity_Error"],
            BannerView.Attention => Localizer["Notifications_Severity_Warning"],
            BannerView.UpgradeProgress or BannerView.ExportProgress => Localizer["Notifications_Severity_Progress"],
            BannerView.Info when info?.Severity == BannerSeverity.Warning =>
                Localizer["Notifications_Severity_Warning"],
            BannerView.Info => Localizer["Notifications_Severity_Info"],
            _ => string.Empty
        };

        string staticSeverityClass = selected.View switch
        {
            BannerView.Error => "notification-card-error",
            BannerView.Attention => "notification-card-warning",
            BannerView.UpgradeProgress or BannerView.ExportProgress => "notification-card-progress",
            BannerView.Info when info?.Severity == BannerSeverity.Warning =>
                "notification-card-warning",
            BannerView.Info => "notification-card-info",
            _ => string.Empty
        };

        <article class="banner-entry @(ShowAllEntries ? staticSeverityClass : string.Empty)" data-notification-card="@(ShowAllEntries ? string.Empty : null)" data-notification-return-trigger="@(ShowAllEntries ? NotificationReturnTriggerId : null)" @key="((object?)selected.EntryId ?? selected.View)" tabindex="@(ShowAllEntries ? "-1" : null)">
            @if (ShowAllEntries)
            {
                <span class="notification-card-severity visually-hidden">@staticSeverityText</span>
            }
            @switch (selected.View)
            {
                case BannerView.Critical when currentCritical != null:
                    <CriticalBanner Critical="currentCritical" />

                    break;

                case BannerView.Error:
                    @if (error is not null)
                    {
                        <ErrorBanner ActionsDisabled="@(ShowAllEntries && Location == BannerHostLocation.InsideModal)"
                            BeforeAction="BeforeAction"
                            CycleNav="cycleNav"
                            Entry="error" StaticPresentation="ShowAllEntries" />
                    }

                    break;

                case BannerView.Attention when attentionEntries.Count > 0:
                    <AttentionBanner ActionsDisabled="@(ShowAllEntries && Location == BannerHostLocation.InsideModal)"
                        AttentionCount="attentionEntries.Count"
                        BeforeAction="BeforeAction"
                        CycleNav="cycleNav"
                        OnFallbackErrorPosted="HandleFallbackErrorPosted"
                        StaticPresentation="ShowAllEntries" />

                    break;

                case BannerView.UpgradeProgress when backgroundProgress != null:
                    <UpgradeProgressBanner CycleNav="cycleNav" Progress="backgroundProgress" StaticPresentation="ShowAllEntries" />

                    break;

                case BannerView.ExportProgress when exportProgress != null:
                    <ExportProgressBanner CycleNav="cycleNav" Export="exportProgress" StaticPresentation="ShowAllEntries" />

                    break;

                case BannerView.Info:
                    @if (info is not null)
                    {
                        <InfoBanner CycleNav="cycleNav" Entry="info" StaticPresentation="ShowAllEntries" />
                    }

                    break;
            }
        </article>
    }
}
