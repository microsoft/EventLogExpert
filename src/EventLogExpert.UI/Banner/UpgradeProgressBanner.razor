<aside class="banner banner-upgrade-progress" role="status">
    <i aria-hidden="true" class="banner-spinner bi bi-arrow-repeat loader-spin"></i>

    @if (string.IsNullOrEmpty(Progress.CurrentEntryName))
    {
        <span class="banner-message">@PluralText.Format(Localizer, "Banner_Upgrade_Preparing", ("count", Progress.CurrentBatchSize))</span>
    }
    else
    {
        <span class="banner-message">
            @Localizer["Banner_Upgrade_InProgress", Progress.CurrentBatchPosition, Progress.CurrentBatchSize, Progress.CurrentEntryName, Progress.CurrentPhase]
        </span>
    }

    @if (Progress.QueuedBatchesAfter > 0)
    {
        <span class="banner-subtitle">@PluralText.Format(Localizer, "Banner_Upgrade_QueuedBatches", ("count", Progress.QueuedBatchesAfter))</span>
    }

    @CycleNav

    <Button CssClass="banner-action"
        OnClick="() => OnCancelUpgradeClickedAsync(Progress)">
        @Localizer["Modal_Cancel"]
    </Button>
</aside>
