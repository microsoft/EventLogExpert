@inherits AppStateComponentBase

@{
    bool showsLiveModel = _model is not null && _selectedHandle == EventFocus.Current?.CurrentHandle;
}

<div class="details-pane" data-toggle="@IsExpanded" hidden="@(_selectedEvent is null)">
    <div class="details-resizer"></div>

    <div class="details-headerbar">
        @if (_isExpanded && _model is not null)
        {
            <div aria-label="@Localizer["Details_TablistAria"].Value" class="details-tabs" role="tablist">
                <button aria-controls="details-tabpanel-reader"
                    aria-selected="@(_activeTab == DetailsTab.Reader ? "true" : "false")"
                    class="details-tab"
                    data-active="@(_activeTab == DetailsTab.Reader ? "true" : "false")"
                    id="details-tab-reader"
                    @onclick="() => SetTab(DetailsTab.Reader)"
                    role="tab"
                    type="button">
                    @Localizer["Details_TabLabel"]
                </button>
                <button aria-controls="details-tabpanel-xml"
                    aria-selected="@(_activeTab == DetailsTab.Xml ? "true" : "false")"
                    class="details-tab"
                    data-active="@(_activeTab == DetailsTab.Xml ? "true" : "false")"
                    id="details-tab-xml"
                    @onclick="() => SetTab(DetailsTab.Xml)"
                    role="tab"
                    type="button">
                    @Localizer["Details_XmlTabLabel"]
                </button>
                <button aria-controls="details-tabpanel-correlation"
                    aria-selected="@(_activeTab == DetailsTab.Correlation ? "true" : "false")"
                    class="details-tab"
                    data-active="@(_activeTab == DetailsTab.Correlation ? "true" : "false")"
                    id="details-tab-correlation"
                    @onclick="() => SetTab(DetailsTab.Correlation)"
                    role="tab"
                    type="button">
                    @Localizer["Details_CorrelationTabLabel"]
                </button>
            </div>
        }
        else
        {
            <span class="details-headerbar-label">@Localizer["Details_TabLabel"]</span>
        }

        <div class="details-headerbar-actions">
            @if (_isExpanded && showsLiveModel)
            {
                <button aria-label="@Localizer["Details_CopyEventAria"].Value"
                    class="details-copy-event"
                    @onclick="CopyEventAsync"
                    title="@Localizer["Details_CopyEventAria"].Value"
                    type="button">
                    <i class="bi bi-clipboard"></i>
                    <span class="details-copy-event-label">@Localizer["Details_CopyEventButtonLabel"]</span>
                </button>
            }
            <Button CssClass="menu-toggle"
                IconClass="bi bi-caret-up"
                IconOnly
                OnClick="ToggleMenu"
                aria-controls="details-body"
                aria-expanded="@IsExpanded"
                aria-label="@Localizer[_isExpanded ? "Details_CollapseAria" : "Details_ExpandAria"].Value"
                data-rotate="@IsExpanded"
                id="details-header"
                title="@Localizer[_isExpanded ? "Details_CollapseAria" : "Details_ExpandAria"].Value" />
        </div>
    </div>

    <div class="details-body" id="details-body">
        @if (_model is not null)
        {
            <div aria-labelledby="details-tab-reader"
                class="details-reader"
                hidden="@(_activeTab != DetailsTab.Reader)"
                id="details-tabpanel-reader"
                role="tabpanel">
                @if (_activeTab == DetailsTab.Reader && showsLiveModel)
                {
                    <div class="details-reader-layout">
                        <div class="reader-rail">
                            <div class="details-summary">
                                <span class="details-summary-id">@Localizer["Details_EventId", _model.EventId]</span>
                                @if (!string.IsNullOrEmpty(_model.Level))
                                {
                                    <span class="details-summary-level">
                                        @if (SeverityIcon.CssClass(_model.Severity) is { Length: > 0 } levelIcon)
                                        {
                                            <span aria-hidden="true"
                                                class="level-icon @levelIcon"
                                                title="@Localizer["Details_SeverityTitle", _model.Level].Value">
                                            </span>
                                        }
                                        @_model.Level
                                    </span>
                                }
                            </div>

                            @if (_model.Header.Count > 0)
                            {
                                <dl class="details-grid">
                                    @foreach (DetailsProperty property in _model.Header)
                                    {
                                        <dt>@DetailsPropertyLocalizer.Label(Localizer, property.Label)</dt>
                                        <dd>@(property.StatusValue is { } status ? ResolutionStatusLocalizer.Display(Localizer, status) : property.Value)</dd>
                                    }
                                </dl>
                            }

                            @if (_selectedEvent is { } correlationEvent && (correlationEvent.ActivityId.HasValue || correlationEvent.RelatedActivityId.HasValue))
                            {
                                <section class="details-correlation">
                                    <h3>@Localizer["Details_CorrelationHeading"]</h3>
                                    <div class="details-correlation-actions">
                                        @if (correlationEvent.ActivityId.HasValue)
                                        {
                                            <button class="button details-correlation-action"
                                                @onclick="() => FilterLensCommands.ShowRelatedByActivityId(correlationEvent.ActivityId, correlationEvent.OwningLog)"
                                                type="button">
                                                @Localizer["Details_ShowRelatedEvents"]
                                            </button>
                                        }
                                        @if (correlationEvent.RelatedActivityId.HasValue)
                                        {
                                            <button class="button details-correlation-action"
                                                @onclick="() => FilterLensCommands.ShowParentActivity(correlationEvent.RelatedActivityId, correlationEvent.OwningLog)"
                                                type="button">
                                                @Localizer["Details_ShowParentActivity"]
                                            </button>
                                        }
                                    </div>
                                </section>
                            }

                            @if (_model.SystemProperties.Count > 0)
                            {
                                <details class="details-section" open>
                                    <summary>
                                        <span>@Localizer["Details_SystemDetailsHeading"]</span>
                                        <button aria-label="@Localizer["Details_CopySystemDetailsAria"].Value"
                                            class="details-copy-section"
                                            @onclick="() => CopyPropertiesAsync(_model.SystemProperties)"
                                            @onclick:preventDefault="true"
                                            @onclick:stopPropagation="true"
                                            title="@Localizer["Details_CopySystemDetailsAria"].Value"
                                            type="button">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </summary>
                                    <dl class="details-grid">
                                        @foreach (DetailsProperty property in _model.SystemProperties)
                                        {
                                            <dt>@DetailsPropertyLocalizer.Label(Localizer, property.Label)</dt>
                                            <dd>
                                                @(property.StatusValue is { } status ?
                                                    ResolutionStatusLocalizer.Display(Localizer, status) : property.Value)
                                            </dd>
                                        }
                                    </dl>
                                </details>
                            }
                        </div>

                        <div class="reader-payload">
                            <section class="details-section">
                                <h3>@Localizer["Details_MessageHeading"]</h3>
                                @if (_model.HasMessage)
                                {
                                    <p class="details-message">@_model.Message</p>
                                }
                                else
                                {
                                    <p class="details-muted">@Localizer["Details_NoMessageText"]</p>
                                }
                            </section>

                            <section class="details-section">
                                <div class="details-section-head">
                                    <h3>@Localizer["Details_EventDataHeading"]</h3>
                                    @if (_model.HasNamedEventData)
                                    {
                                        <button aria-label="@Localizer["Details_CopyEventDataAria"].Value"
                                            class="details-copy-section"
                                            @onclick="() => CopyFieldsAsync(_model.EventData)"
                                            title="@Localizer["Details_CopyEventDataAria"].Value"
                                            type="button">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    }
                                </div>

                                @if (_model.HasNamedEventData)
                                {
                                    <div class="details-fields">
                                        @for (int i = 0; i < _model.EventData.Count; i++)
                                        {
                                            int index = i;
                                            DetailsField field = _model.EventData[index];

                                            <DetailsFieldRow Field="field"
                                                IsExpanded="IsFieldExpanded(index)"
                                                OnCopy="() => CopyValueAsync(field)"
                                                OnToggleExpand="() => ToggleFieldExpansion(index)" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="details-muted">@Localizer["Details_NoNamedDataFieldsText"]</p>
                                }
                            </section>

                            @if (_model.UserData.Count > 0)
                            {
                                <section class="details-section">
                                    <div class="details-section-head">
                                        <h3>@Localizer["Details_UserDataHeading"]</h3>
                                        <button aria-label="@Localizer["Details_CopyUserDataAria"].Value"
                                            class="details-copy-section"
                                            @onclick="() => CopyFieldsAsync(_model.UserData)"
                                            title="@Localizer["Details_CopyUserDataAria"].Value"
                                            type="button">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>

                                    @if (_model.UserDataIncomplete)
                                    {
                                        <p class="details-warn">@Localizer["Details_UserDataIncompleteText"]</p>
                                    }

                                    <div class="details-fields-userdata">
                                        @for (int j = 0; j < _model.UserData.Count; j++)
                                        {
                                            int index = _model.EventData.Count + j;
                                            DetailsField field = _model.UserData[j];

                                            <DetailsFieldRow Field="field"
                                                IsExpanded="IsFieldExpanded(index)"
                                                OnCopy="() => CopyValueAsync(field)"
                                                OnToggleExpand="() => ToggleFieldExpansion(index)" />
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                }
            </div>

            <p aria-labelledby="details-tab-xml" class="details-xml" hidden="@(_activeTab != DetailsTab.Xml)" id="details-tabpanel-xml" role="tabpanel">
                @if (_activeTab == DetailsTab.Xml && showsLiveModel)
                {
                    @if (_resolvedXml is null)
                    {
                        <text>@Localizer["Details_ResolvingXmlText"]</text>
                    }
                    else if (_resolvedXml.Length > 0)
                    {
                        @GetXmlForDisplay()
                    }
                    else
                    {
                        <text>@Localizer["Details_NoXmlText"]</text>
                    }
                }
            </p>

            <div aria-labelledby="details-tab-correlation"
                class="details-correlation-tab"
                hidden="@(_activeTab != DetailsTab.Correlation)"
                id="details-tabpanel-correlation"
                role="tabpanel">
                <ActivityCorrelationPanel FocusedHandle="_selectedHandle"
                    IsActive="_activeTab == DetailsTab.Correlation"
                    SelectedEvent="_selectedEvent" />
            </div>
        }
    </div>
</div>
