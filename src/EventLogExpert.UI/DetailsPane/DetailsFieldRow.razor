<div class="details-field @(Field.IsMuted ? "is-muted" : null) @(Field.PreferFullWidth ? "is-wide" : null)">
    <div class="details-field-name">
        <span>@Field.Label</span>
        <button aria-label="@Localizer["Details_CopyValueAria", Field.Label].Value"
            class="details-copy"
            @onclick="OnCopy"
            title="@Localizer["Details_CopyValueAria", Field.Label].Value"
            type="button">
            <i class="bi bi-clipboard"></i>
        </button>
    </div>
    <div class="details-field-value">
        @if (Field.Placeholder is { } kind)
        {
            <div class="details-value-line @(Field.IsMonospace ? "is-mono" : null)">@Localizer[PlaceholderKey(kind)]</div>
        }
        else if (Field.DecodedLabel is { } decoded)
        {
            <div class="details-value-line @(Field.IsMonospace ? "is-mono" : null)">
                @Field.PreviewLines[0]<span class="details-decoded"> (@decoded)</span>
            </div>
        }
        else
        {
            @foreach (string line in (IsExpanded ? Field.FullLines : Field.PreviewLines))
            {
                <div class="details-value-line @(Field.IsMonospace ? "is-mono" : null)">@line</div>
            }

            @if (Field.IsTruncated)
            {
                <button aria-expanded="@(IsExpanded ? "true" : "false")"
                    class="details-show-more"
                    @onclick="OnToggleExpand"
                    type="button">
                    @Localizer[IsExpanded ? "Details_ShowLess" : "Details_ShowMore"]
                </button>
            }
        }

        @if (Field.Explanation is { } term)
        {
            <div class="details-explain">@GlossaryLocalizer.Description(Localizer, term)</div>
        }
    </div>
</div>
